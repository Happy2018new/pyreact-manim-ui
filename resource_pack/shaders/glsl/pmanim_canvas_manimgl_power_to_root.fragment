            fanEdge(px, py, a, base, winding);
            }
        }
        {
            // Cull the complete fan including its base, border and subpixel samples.
            if (all(greaterThanEqual(p, vec2(1.132174176, -0.8335676793) - vec2(fanMargin))) &&
                all(lessThanEqual(p, vec2(1.512420017, 0.3610515002) + vec2(fanMargin)))) {
            vec2 a = samplePoint(639.0, frames);
            fanEdge(px, py, base, a, winding);
            for (int i = 1; i < 4; ++i) {
                vec2 b = samplePoint(639.0 + float(i), frames);
                fanEdge(px, py, a, b, winding);
                distanceToCurve = min(distanceToCurve, fanSegmentDistance(px, py, a, b));
                a = b;
            }
            fanEdge(px, py, a, base, winding);
            }
        }
        {
            // Cull the complete fan including its base, border and subpixel samples.
            if (all(greaterThanEqual(p, vec2(1.132174176, -0.6963179115) - vec2(fanMargin))) &&
                all(lessThanEqual(p, vec2(1.512420017, 0.3610515002) + vec2(fanMargin)))) {
            vec2 a = samplePoint(643.0, frames);
            fanEdge(px, py, base, a, winding);
            for (int i = 1; i < 5; ++i) {
                vec2 b = samplePoint(643.0 + float(i), frames);
                fanEdge(px, py, a, b, winding);
                distanceToCurve = min(distanceToCurve, fanSegmentDistance(px, py, a, b));
                a = b;
            }
            fanEdge(px, py, a, base, winding);
            }
        }
        {
            // Cull the complete fan including its base, border and subpixel samples.
            if (all(greaterThanEqual(p, vec2(1.17555837, -0.4627188448) - vec2(fanMargin))) &&
                all(lessThanEqual(p, vec2(1.512420017, 0.3610515002) + vec2(fanMargin)))) {
            vec2 a = samplePoint(648.0, frames);
            fanEdge(px, py, base, a, winding);
            for (int i = 1; i < 2; ++i) {
                vec2 b = samplePoint(648.0 + float(i), frames);
                fanEdge(px, py, a, b, winding);
                distanceToCurve = min(distanceToCurve, fanSegmentDistance(px, py, a, b));
                a = b;
            }
            fanEdge(px, py, a, base, winding);
            }
        }
        {
            // Cull the complete fan including its base, border and subpixel samples.
            if (all(greaterThanEqual(p, vec2(1.18317644, -0.4323175851) - vec2(fanMargin))) &&
                all(lessThanEqual(p, vec2(1.512420017, 0.3610515002) + vec2(fanMargin)))) {
            vec2 a = samplePoint(650.0, frames);
            fanEdge(px, py, base, a, winding);
            for (int i = 1; i < 2; ++i) {
                vec2 b = samplePoint(650.0 + float(i), frames);
                fanEdge(px, py, a, b, winding);
                distanceToCurve = min(distanceToCurve, fanSegmentDistance(px, py, a, b));
                a = b;
            }
            fanEdge(px, py, a, base, winding);
            }
        }
        vec4 fill = staticColor(1322.0);
        // Native signed alpha is accumulated in the 2x fill canvas before filtering.
        // Bound the exponent, not winding: faint overlapping shapes must still accumulate.
        vec4 signedExponent = log(1.0 - 0.95 * fill.a) * winding * 1.0;
        vec4 coverageSamples = vec4(1.0) - exp(clamp(signedExponent, -80.0, 80.0));
        if (borderHalfWidth > 0.0) {
            // Native fill-border uses real curves only, never the artificial fan edges.
            vec4 borderCoverage = 1.0 - smoothstep(borderHalfWidth - borderHalfAA, borderHalfWidth + borderHalfAA, distanceToCurve);
            // MAX applies only where border geometry exists: zero must not erase negative fill elsewhere.
            vec4 borderPresent = vec4(1.0) - step(vec4(borderHalfWidth + borderHalfAA), distanceToCurve);
            coverageSamples = mix(coverageSamples, max(coverageSamples, borderCoverage * (0.95 * fill.a)), borderPresent);
        }
        float coverage = dot(coverageSamples, vec4(0.25));
        if (coverage < 0.0) coverage = -coverage / (1.0 - coverage);
        canvasOver(canvasPremultiplied, canvasAlpha, fill.rgb, coverage * 1.06);
        }
    }
    }
    vec3 straightColor = canvasAlpha > 0.0 ? canvasPremultiplied / canvasAlpha : vec3(0.0);
    gl_FragColor = vec4(straightColor, canvasAlpha * clamp(EXTRA_ACTOR_UNIFORM1.w, 0.0, 1.0));
}

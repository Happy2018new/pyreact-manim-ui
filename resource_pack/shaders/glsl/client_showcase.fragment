}
}

vec3 atmosphere(vec2 p,float t,float aa) {
    // One restrained lighting plane gives the mathematical forms their space.
    vec3 c=vec3(0.009,0.021,0.046);
    float depth=exp(-dot((p-vec2(-2.4,0.8))*vec2(0.20,0.29),(p-vec2(-2.4,0.8))*vec2(0.20,0.29)));
    c+=vec3(0.008,0.027,0.048)*depth;
    return c;
}
vec3 introStage(vec2 p,float t,float aa) {
    vec3 c=vec3(0.0);
    float draw=smoothstep(0.0,1.35,t);
    for(int layer=0;layer<6;layer++) {
        float lane=float(layer),d=100.0;
        vec2 previous=geoIntroPoint(0.0,lane,t);
        for(int j=1;j<=72;j++) {
            float u=float(j)/72.0;
            vec2 current=geoIntroPoint(min(u,draw),lane,t);
            d=min(d,lineDistance(p,previous,current));
            previous=current;
        }
        vec3 hue=layer==0?GOLD:mix(vec3(0.045,0.28,0.58),CYAN,lane/5.0);
        float power=layer==5?1.12:layer==0?0.92:0.56;
        c+=glow(d,layer==5?0.023:0.012,hue,power,aa);
    }
    float reading=mix(1.0,geoReadingMask(p,vec2(0.0,0.25),vec2(5.7,0.91)),smoothstep(0.2,1.0,t));
    return c*reading*gate(t,0.0,12.0);
}
vec3 algebraStage(vec2 p,float t,float aa) {
    vec3 c=vec3(0.0);
    // Four full-size area tiles retain their dimensions through the expansion.
    if(t<32.4) {
        float separate=smoothstep(28.8,29.6,t);
        float assemble=smoothstep(30.8,32.1,t);
        for(int j=0;j<4;j++) {
            vec2 offset,halfSize,spread;
            float turn=0.0;
            vec3 hue;
            if(j==0) {
                offset=vec2(-0.625,-0.625); halfSize=vec2(1.25);
                spread=vec2(-4.7,-1.9); hue=CYAN;
            } else if(j==1) {
                offset=vec2(1.25,-0.625); halfSize=vec2(0.625,1.25);
                spread=vec2(-1.3,-1.9); hue=mix(CYAN,GOLD,0.35); turn=PI*0.5;
            } else if(j==2) {
                offset=vec2(-0.625,1.25); halfSize=vec2(1.25,0.625);
                spread=vec2(2.0,-1.9); hue=mix(CYAN,GOLD,0.35);
            } else {
                offset=vec2(1.25,1.25); halfSize=vec2(0.625);
                spread=vec2(5.15,-1.9); hue=GOLD;
            }
            vec2 joined=vec2(-3.1,-1.5)+offset;
            vec2 center=mix(mix(joined,spread,separate),vec2(3.1,-1.5)+offset,assemble);
            c+=geoPanel(p,center,halfSize,turn*separate*(1.0-assemble),hue,0.30,aa);
        }
        float brace=separate*(1.0-assemble);
        c+=glow(lineDistance(p,vec2(-2.55,-2.9),vec2(3.25,-2.9)),0.012,GOLD,0.85*brace,aa);
        c+=glow(lineDistance(p,vec2(-2.55,-2.9),vec2(-2.55,-2.68)),0.012,GOLD,0.85*brace,aa);
        c+=glow(lineDistance(p,vec2(3.25,-2.9),vec2(3.25,-2.68)),0.012,GOLD,0.85*brace,aa);
        return c*gate(t,28.0,32.4);
    }
    // Completing the square turns two equal rectangles around x^2. The last
    // gold corner completes the area; the equal side is extracted afterward.
    float square=smoothstep(37.8,38.6,t);
    float extract=smoothstep(39.6,42.1,t);
    float rounding=smoothstep(44.5,47.35,t);
    vec2 assembledCenter=mix(vec2(2.45,-1.5),vec2(0.4,-1.5),extract);
    for(int j=0;j<4;j++) {
        vec2 offset,halfSize,spread;
        float startAngle=0.0;
        vec3 hue;
        if(j==0) {
            offset=vec2(-0.6,-0.6); halfSize=vec2(1.2);
            spread=vec2(-4.5,-1.8); hue=CYAN;
        } else if(j==1) {
            offset=vec2(1.2,-0.6); halfSize=vec2(0.6,1.2);
            spread=vec2(-1.2,-1.8); hue=mix(CYAN,GOLD,0.35); startAngle=PI*0.5;
        } else if(j==2) {
            offset=vec2(-0.6,1.2); halfSize=vec2(1.2,0.6);
            spread=vec2(2.05,-1.8); hue=mix(CYAN,GOLD,0.35);
        } else {
            offset=vec2(1.2,1.2); halfSize=vec2(0.6);
            spread=vec2(5.3,-1.8); hue=GOLD;
        }
        float join=j==3?smoothstep(38.15,39.15,t):square;
        vec2 center=mix(spread,assembledCenter+offset,join);
        float visible=j==3?smoothstep(36.2,37.6,t):1.0;
        vec3 panel=geoPanel(p,center,halfSize,startAngle*(1.0-square),hue,0.30*(1.0-extract),aa);
        c+=panel*visible*(1.0-0.80*extract)*(1.0-rounding);
    }
    float left=assembledCenter.x-1.8,right=assembledCenter.x+1.8;
    float measure=smoothstep(39.0,40.5,t)*(1.0-smoothstep(43.8,45.6,t));
    c+=glow(lineDistance(p,vec2(left,0.65),vec2(right,0.65)),0.022,GOLD,1.12*measure,aa);
    c+=glow(lineDistance(p,vec2(left,0.51),vec2(left,0.79)),0.010,GOLD,measure,aa);
    c+=glow(lineDistance(p,vec2(right,0.51),vec2(right,0.79)),0.010,GOLD,measure,aa);
    // The extracted square perimeter becomes the next chapter's circle.
    float perimeter=smoothstep(41.0,42.5,t);
    float d=100.0;
    vec2 previous=vec2(0.0);
    for(int j=0;j<=96;j++) {
        float u=float(j)/96.0;
        float a=u*TAU+PI*0.25;
        vec2 box=geoPolygon(u,4.0,2.5455844,PI*0.25);
        vec2 circle=vec2(cos(a),sin(a))*2.02;
        vec2 current=mix(box,circle,rounding)+mix(assembledCenter,vec2(-1.75,-0.8),rounding);
        if(j>0) d=min(d,lineDistance(p,previous,current));
        previous=current;
    }
    c+=glow(d,0.023,CYAN,1.12*perimeter,aa);
    return c*gate(t,32.4,48.0);
}
vec3 closingStage(vec2 p,float t,float aa) {
    vec3 c=vec3(0.0);
    float settle=smoothstep(114.0,118.0,t);
    for(int layer=0;layer<6;layer++) {
        float lane=float(layer),d=100.0,crossings=0.0;
        vec2 previous=geoClosingPoint(0.0,lane,t);
        for(int j=1;j<=64;j++) {
            vec2 current=geoClosingPoint(float(j)/64.0,lane,t);
            d=min(d,lineDistance(p,previous,current));
            crossings+=geoRayCrossing(p,previous,current);
            previous=current;
        }
        vec3 hue=layer==0?GOLD:mix(vec3(0.04,0.25,0.48),CYAN,lane/5.0);
        float power=layer==0?0.82:layer==5?0.90:0.44;
        float wings=mix(1.0,smoothstep(2.6,5.1,abs(p.x)),settle);
        c+=hue*mod(crossings,2.0)*(0.018+lane*0.004)*(1.0-settle);
        c+=glow(d,layer==5?0.017:0.010,hue,power*mix(1.0,0.65,settle),aa)*wings;
    }
    return c*geoReadingMask(p,vec2(0.0,0.15),vec2(mix(3.35,5.95,smoothstep(114.0,115.0,t)),0.76));
}
void main() {
    vec2 v=uv;
    if(EXTRA_VECTOR2.x>0.5) v.y=1.0-v.y;
    float height=EXTRA_VECTOR2.z>0.0?EXTRA_VECTOR2.z:1.0;
    vec2 local=vec2(v.x,(v.y-EXTRA_VECTOR2.y)/height);
    vec4 original=texture2D(TEXTURE_0,uv);
    if(local.y<0.0 || local.y>1.0) { gl_FragColor=original; return; }
    float aspect=EXTRA_VECTOR1.y;
    float narrow=max(1.0,(16.0/9.0)/aspect);
    vec2 p=vec2((local.x-0.5)*aspect,0.5-local.y)*9.0*narrow;
    float aa=9.0/max(EXTRA_VECTOR1.z,1.0)*narrow;
    float t=clamp(EXTRA_VECTOR1.x,0.0,120.0);
    vec3 c=atmosphere(p,t,aa);
    if(t<12.0) c+=introStage(p,t,aa);
    c+=geometryAct(p,t,aa);
    if(t>=28.0 && t<48.0) c+=algebraStage(p,t,aa);
    if(t>=114.0) c+=closingStage(p,t,aa);
    typography(c,p,t,aa);
    c*=0.9+0.1*exp(-dot(p,p)*0.01);
    c=clamp(c,0.0,1.0)*smoothstep(0.0,0.6,t);
    gl_FragColor=mix(original,vec4(c,1.0),clamp(EXTRA_VECTOR1.w,0.0,1.0));
}

// __multiversion__
// Original curved-vector storybook; seven chapters share one continuous world.
precision highp float;
#include "fragmentVersionCentroidUV.h"
uniform sampler2D TEXTURE_0;
uniform sampler2D TEXTURE_2;
uniform vec4 EXTRA_VECTOR1;
uniform vec4 EXTRA_VECTOR2;
const float PI=3.14159265359;
const float TAU=6.28318530718;
const vec3 INK=vec3(.047,.068,.128);
const vec3 TEAL=vec3(.19,.39,.40);
const vec3 MIST=vec3(.46,.64,.61);
const vec3 GOLD=vec3(.91,.70,.38);
const vec3 PAPER=vec3(.90,.85,.69);
const vec3 CORAL=vec3(.70,.29,.26);
float sat(float x) { return clamp(x,0.,1.); }
float ease(float a,float b,float t) { return smoothstep(a,b,t); }
float hash(float n) { return fract(sin(n*127.1+311.7)*43758.5453); }
mat2 rotate(float a) { return mat2(cos(a),-sin(a),sin(a),cos(a)); }
float fill(float d,float aa) { return 1.-smoothstep(-aa,aa,d); }
float ellipse(vec2 p,vec2 s) { return (length(p/s)-1.)*min(s.x,s.y); }
float box(vec2 p,vec2 s) { vec2 v=abs(p)-s; return min(max(v.x,v.y),0.)+length(max(v,0.)); }
float segment(vec2 p,vec2 a,vec2 b) {
    vec2 v=b-a; return length(p-a-v*sat(dot(p-a,v)/max(dot(v,v),.0000001)));
}
void paint(inout vec3 c,float d,vec3 hue,float opacity,float aa) { c=mix(c,hue,fill(d,aa)*opacity); }
void contourEdge(vec2 p,vec2 a,vec2 b,inout float d,inout float winding) {
    vec2 e=b-a,w=p-a,r=w-e*sat(dot(w,e)/max(dot(e,e),.0000001));
    d=min(d,dot(r,r));
    if((a.y>p.y)!=(b.y>p.y)) {
        if(p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x) winding=-winding;
    }
}
vec2 bezier(vec2 a,vec2 b,vec2 c,vec2 d,float u) {
    float v=1.-u; return v*v*v*a+3.*v*v*u*b+3.*v*u*u*c+u*u*u*d;
}
float curve(vec2 p,vec2 a,vec2 b,vec2 c,vec2 d,float progress) {
    vec2 low=min(min(a,b),min(c,d))-.18,high=max(max(a,b),max(c,d))+.18;
    if(p.x<low.x || p.y<low.y || p.x>high.x || p.y>high.y) return 20.;
    float distance=20.; vec2 previous=a;
    for(int k=1;k<=18;k++) {
        vec2 current=bezier(a,b,c,d,float(k)/18.*progress);
        distance=min(distance,segment(p,previous,current)); previous=current;
    }
    return distance;
}
void inkCurve(inout vec3 c,vec2 p,vec2 a,vec2 b,vec2 cc,vec2 d,float width,vec3 hue,float alpha,float aa) {
    paint(c,curve(p,a,b,cc,d,1.)-width,hue,alpha,aa);
}

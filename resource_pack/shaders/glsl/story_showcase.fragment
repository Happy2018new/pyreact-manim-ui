vec2 bound=abs(p-vec2(0.16503,0.24660))-vec2(0.16296,0.29140);
if(max(bound.x,bound.y)>0.) return max(bound.x,bound.y)+.018;
float d=100.; float winding=1.; vec2 a=vec2(0.02007,0.35882); vec2 b;
b=vec2(0.13000,0.52000); contourEdge(p,a,b,d,winding); a=b;

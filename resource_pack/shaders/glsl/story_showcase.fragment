void main() {
    vec2 v=uv; if(EXTRA_VECTOR2.x>.5) v.y=1.-v.y;
    float height=EXTRA_VECTOR2.z>0.?EXTRA_VECTOR2.z:1.;
    vec2 local=vec2(v.x,(v.y-EXTRA_VECTOR2.y)/height); vec4 original=texture2D(TEXTURE_0,uv);
    if(local.y<0. || local.y>1.) { gl_FragColor=original; return; }
    float aspect=max(EXTRA_VECTOR1.y,.1),narrow=max(1.,(16./9.)/aspect);
    vec2 p=vec2((local.x-.5)*aspect,.5-local.y)*9.*narrow;
    float aa=9./max(EXTRA_VECTOR1.z,1.)*narrow,t=clamp(EXTRA_VECTOR1.x,0.,120.);
    float cloud=ease(29.,39.,t)*(1.-ease(50.,59.,t)); vec3 c=sky(p,t);
    stars(c,p,t,aa);
    vec2 moon=p-vec2(4.10,1.94);
    paint(c,max(length(moon)-.55,-(length(moon-vec2(.18,.10))-.52)),vec3(.49,.59,.53),.70,aa);
    c+=PAPER*.017*exp(-dot(moon,moon)*.65);
    landscape(c,p,t,cloud,aa); forest(c,p,t,aa); treeDetails(c,p,t,aa);
    vessel(c,p,t,aa); narrativeCurves(c,p,t,aa); leafFlight(c,p,t,aa);
    float catchMove=ease(13.,20.,t),voyageMove=ease(31.,37.,t),land=ease(50.,57.,t),plant=ease(73.,80.,t);
    vec2 at=mix(vec2(-3.3,-2.53),vec2(-2.35,-2.58),catchMove); float size=mix(.58,.86,catchMove);
    at=mix(at,boatCenter(t)+vec2(.25,.14),voyageMove); size=mix(size,.49,voyageMove);
    at=mix(at,vec2(-.62,-2.64),land); size=mix(size,.74,land);
    at=mix(at,vec2(-2.45,-2.55),plant); size=mix(size,.58,plant); at.x-=ease(102.,115.,t)*.55;
    float wind=.45+cloud*.28+ease(53.,59.,t)*(1.-ease(73.,78.,t))*.95;
    girl(c,p,at,size,t,wind,aa);
    vec2 hand=at+vec2(.72,2.08)*size,seedAt=mix(vec2(3.85,1.84),hand,ease(6.,23.,t));
    seedAt+=vec2(sin(ease(6.,23.,t)*PI)*.9,sin(ease(6.,23.,t)*PI)*.6);
    seedAt=mix(seedAt,vec2(.06,-2.38),ease(73.,78.,t));
    float seedRadius=.052*(1.-ease(78.,81.,t));
    if(seedRadius>.001 && t>4.) seed(c,p,seedAt,max(.002,seedRadius*ease(4.,6.,t)),t,aa);
    foreground(c,p,t,aa); particles(c,p,t,aa);
    c*=1.-.27*(1.-ease(-3.60,-2.55,p.y));
    c*=1.-.12*sat(dot(p*vec2(.075,.10),p*vec2(.075,.10)));
    c+=(fract(sin(dot(floor(gl_FragCoord.xy),vec2(12.9898,78.233)))*43758.5453)-.5)*.004;
    typography(c,p,t,aa);
    c*=1.-ease(3.69,3.73,abs(p.y)); c*=ease(0.,1.2,t);
    gl_FragColor=mix(original,vec4(clamp(c,0.,1.),1.),clamp(EXTRA_VECTOR1.w,0.,1.));
}

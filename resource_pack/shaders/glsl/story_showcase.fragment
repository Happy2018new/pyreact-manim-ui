b=mix(mix(vec2(-0.26859,0.04314),vec2(-0.52651,0.36953)*vec2(1.,wing),morph),vec2(-0.08080,0.00412),constellation); contourEdge(p,a,b,d,winding); a=b;
b=mix(mix(vec2(-0.25068,0.05647),vec2(-0.46998,0.36613)*vec2(1.,wing),morph),vec2(-0.07129,0.00656),constellation); contourEdge(p,a,b,d,winding); a=b;
b=mix(mix(vec2(-0.23177,0.06841),vec2(-0.41528,0.35087)*vec2(1.,wing),morph),vec2(-0.06181,0.00912),constellation); contourEdge(p,a,b,d,winding); a=b;
b=mix(mix(vec2(-0.21285,0.08036),vec2(-0.36457,0.32534)*vec2(1.,wing),morph),vec2(-0.05257,0.01245),constellation); contourEdge(p,a,b,d,winding); a=b;

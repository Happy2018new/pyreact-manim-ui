// __multiversion__
// Wind's Reply: twenty-four living curves remember one celestial flower.
// Fine filaments repeat across nearest-curve coordinates, never per-strand loops.
precision highp float;
#include "fragmentVersionCentroidUV.h"
uniform sampler2D TEXTURE_0;
uniform sampler2D TEXTURE_2;
uniform vec4 EXTRA_VECTOR1;
uniform vec4 EXTRA_VECTOR2;
const float PI=3.14159265359;
const float TAU=6.28318530718;
const vec3 PAPER=vec3(1.,.965,.865);
const vec3 GOLD=vec3(1.,.62,.19);
const vec3 CYAN=vec3(.12,.76,1.);
const vec3 VIOLET=vec3(.48,.25,1.);
const vec3 MAGENTA=vec3(.96,.19,.66);
float sat(float x) { return clamp(x,0.,1.); }
float ease(float a,float b,float t) { return smoothstep(a,b,t); }
float hash(float n) { return fract(sin(n*127.1+311.7)*43758.5453); }
mat2 rotate(float a) { return mat2(cos(a),-sin(a),sin(a),cos(a)); }
float fill(float d,float aa) { return 1.-smoothstep(-aa,aa,d); }
vec2 polar(float a,float r) { return vec2(cos(a),sin(a))*r; }
float segment(vec2 p,vec2 a,vec2 b) {
    vec2 e=b-a; return length(p-a-e*sat(dot(p-a,e)/max(dot(e,e),.0000001)));
}
vec2 bezier(vec2 a,vec2 b,vec2 c,vec2 d,float u) {
    float v=1.-u; return v*v*v*a+3.*v*v*u*b+3.*v*u*u*c+u*u*u*d;
}
void glowLine(inout vec3 c,float d,float width,vec3 hue,float power,float aa) {
    c+=hue*power*(fill(d-width,aa)+.13*exp(-d*37.)+.021*exp(-d*11.));
}
float repeatedLine(float d,float spacing,float count) {
    float strand=clamp(floor(d/spacing+.5),-count,count);
    return abs(d-strand*spacing);
}
vec3 storyPieceColor(float i) {
    float k=mod(i,6.);
    if(k<1.) return mix(GOLD,PAPER,.14);
    if(k<3.) return mix(CYAN,VIOLET,(k-1.)*.31);
    if(k<5.) return mix(VIOLET,MAGENTA,(k-3.)*.61);
    return mix(CYAN,PAPER,.20);
}
vec2 nucleus(float t) { return vec2(mix(-1.2,0.,ease(16.,24.,t)),.45); }
float wholeAngle(float t) { return .12*sin((t-20.)*.14)+(t-20.)*.014; }
float wholeScale(float t) { return 1.+.035*sin((t-20.)*.43); }
float petalAngle(float i) { return mod(i,12.)*TAU/12.+floor(i/12.)*PI/12.; }
float petalUnit(float i) { return mix(1.,.66,floor(i/12.)); }
vec2 originalCenter(float i) { return rotate(petalAngle(i))*vec2(1.17,0.)*petalUnit(i); }
vec2 crownCenter(float i) { return rotate(petalAngle(i))*vec2(1.15,0.)*petalUnit(i); }
vec2 burstTarget(float i) {
    float a=i*2.399963+.30,r=3.1+hash(i+13.)*3.15;
    return vec2(cos(a)*r,sin(a)*(1.65+hash(i+7.)*.68))+vec2(0.,.45);
}
vec2 driftPosition(float i,float t) {
    float age=max(0.,t-50.); vec2 from=burstTarget(i);
    vec2 drift=from+vec2(sin(age*.20+i)*.66,cos(age*.23+i*.8)*.34)*ease(50.,57.,t);
    float a=i*2.399963+.30+(t-64.)*(.17+hash(i+8.)*.055);
    float r=1.7+mod(i,8.)*.59;
    vec2 orbit=vec2(cos(a)*r,sin(a)*r*.47)+vec2(0.,.45);
    return mix(drift,orbit,ease(64.,73.,t));
}
float gatherStart(float i) { return 78.+i/23.*9.; }
float gatherAmount(float i,float t) { return ease(gatherStart(i),gatherStart(i)+7.,t); }
float wingAmount(float i,float t) { return ease(94.+mod(i,12.)*.10,104.+mod(i,12.)*.10,t); }
void wingEnds(float i,float t,out vec2 root,out vec2 tip) {
    float side=i<6.?-1.:1.,order=mod(i,6.),framing=ease(104.,110.,t);
    root=vec2(side*mix(.24,1.34,framing),mix(.45,1.72,framing));
    tip=vec2(side*(6.30-order*.21),2.35-order*.67+framing*.48);
}
vec2 lateCenter(float i,float t) {
    float framing=ease(104.,110.,t);
    if(i>11.5) return crownCenter(i)*mix(.95,.43,framing)+vec2(0.,mix(.45,2.03,framing));
    vec2 root,tip; wingEnds(i,t,root,tip); return mix(root,tip,.5);
}
vec2 pieceCenter(float i,float t) {
    if(t<43.) return nucleus(t)+rotate(wholeAngle(t))*originalCenter(i)*ease(12.,20.,t)*wholeScale(t);
    if(t<50.) {
        vec2 from=nucleus(43.)+rotate(wholeAngle(43.))*originalCenter(i)*wholeScale(43.);
        vec2 to=burstTarget(i),impulse=to-from; float u=ease(43.+hash(i+12.)*.24,50.,t);
        return bezier(from,from+impulse*.56+vec2(0.,.72),to-impulse*.12,to,u);
    }
    float start=gatherStart(i); if(t<start) return driftPosition(i,t);
    vec2 destination=vec2(0.,.45)+crownCenter(i);
    if(t<94.) {
        vec2 from=driftPosition(i,start); float side=mod(i,2.)<.5?-1.:1.;
        vec2 c1=rotate(side*.75)*(from-vec2(0.,.45))*.95+vec2(0.,.45);
        vec2 c2=destination+rotate(side*.82)*(destination-vec2(0.,.45))*1.12;
        return bezier(from,c1,c2,destination,gatherAmount(i,t));
    }
    return mix(destination,lateCenter(i,t),wingAmount(i,t));
}
vec2 transformedCurve(vec2 phase,vec4 coefficients,float secondSine,mat2 turn,
                      float wing,float side,vec2 span) {
    // A single rotating unit vector supplies all three petal harmonics.
    // Coefficients, scale and orientation are invariant across its 32 samples.
    float twiceCos=2.*phase.x*phase.x-1.,twiceSin=2.*phase.x*phase.y;
    float tripleCos=phase.x*(4.*phase.x*phase.x-3.);
    vec2 q=turn*vec2(coefficients.x*phase.x+coefficients.y*twiceCos+coefficients.z*tripleCos,
                     coefficients.w*phase.y+secondSine*twiceSin);
    if(wing>.001) {
        float travel=.5-.5*phase.x;
        vec2 feather=-span*.5*phase.x+vec2(side*.43,.56)*phase.y;
        feather.y+=.46*sin(PI*travel)+.16*sin(TAU*travel)*phase.y;
        q=mix(q,feather,wing);
    }
    return q;
}
void pieces(inout vec3 c,vec2 p,float t,float aa) {
    if(t<12.) return;
    float born=ease(12.,20.,t),framing=ease(104.,110.,t);
    for(int j=0;j<24;j++) {
        float i=float(j),unit=petalUnit(i),gather=gatherAmount(i,t),wing=wingAmount(i,t);
        float loose=ease(43.,48.,t)*(1.-gather),size=mix(wholeScale(min(t,43.)),.32,loose)*unit*born;
        float spin=(min(t,gatherStart(i))-43.)*(.32+hash(i+6.)*.26)*ease(43.,45.,t);
        float angle=petalAngle(i)+(wholeAngle(min(t,43.))+spin)*(1.-gather);
        vec2 at=pieceCenter(i,t),q=p-at,root=vec2(0.),tip=vec2(0.);
        float broad=1.62*size+.18;
        if(t>=94. && i<11.5) {
            wingEnds(i,t,root,tip);
            vec2 halfbox=abs(tip-root)*.5+vec2(.65,1.02);
            halfbox=mix(vec2(broad),halfbox,wing);
            if(abs(q.x)>halfbox.x || abs(q.y)>halfbox.y) continue;
        } else {
            if(i>11.5 && t>=94.) size*=mix(1.,mix(.95,.43,framing),wing);
            if(max(abs(q.x),abs(q.y))>broad) continue;
            wing=0.;
        }
        mat2 turn=rotate(angle)*size;
        vec4 coefficients=vec4(mix(1.29,1.35,gather),.10*(1.-gather),.18*gather,mix(.59,.58,gather));
        float secondSine=mix(-.22,.21,gather),side=i<6.?-1.:1.;
        vec2 phase=vec2(1.,0.),span=tip-root;
        float distance=20.,nearest=0.;
        vec2 previous=transformedCurve(phase,coefficients,secondSine,turn,wing,side,span);
        // Thirty-two segments per persistent curve; seven filaments share its
        // nearest coordinate. Bounds keep remote pieces out of this loop.
        for(int k=1;k<=32;k++) {
            phase=mat2(.9807852804,.1950903220,-.1950903220,.9807852804)*phase;
            vec2 current=transformedCurve(phase,coefficients,secondSine,turn,wing,side,span);
            vec2 lo=min(previous,current)-.16,hi=max(previous,current)+.16;
            if(q.x>=lo.x && q.x<=hi.x && q.y>=lo.y && q.y<=hi.y) {
                vec2 edge=current-previous;
                float along=sat(dot(q-previous,edge)/max(dot(edge,edge),.000001));
                float candidate=length(q-mix(previous,current,along));
                if(candidate<distance) { distance=candidate; nearest=(float(k)-1.+along)/32.; }
            }
            previous=current;
        }
        if(distance>.15) continue;
        vec3 hue=storyPieceColor(i);
        float spacing=(.026+.007*wing)*(.55+.45*min(size,1.));
        float threads=repeatedLine(distance,spacing,3.);
        float envelope=1.-ease(spacing*2.5,spacing*3.65,distance);
        float rhythm=.72+.28*sin(nearest*TAU*2.-t*.75+i);
        c+=hue*fill(threads-(.0035+.0015*wing),aa)*envelope*(.35+.12*wing)*rhythm;
        glowLine(c,distance,.007+loose*.003,mix(hue,PAPER,.19),(.83+loose*.25)*born,aa);
        float packet=pow(.5+.5*cos(nearest*TAU-t*(.8+hash(i)*.3)+i*1.7),22.);
        c+=mix(hue,PAPER,.62)*packet*fill(distance-.015,aa)*.78;
    }
}

vec2 openingWind(float i,float u) {
    float offset=(i-1.)*.20;
    vec2 q=bezier(vec2(-8.4,.90+offset),vec2(-3.2,1.30+offset),
                  vec2(-1.4,-2.55-offset),vec2(8.4,-1.25-offset),u);
    q.y+=sin(u*TAU*1.5+i*.48)*sin(PI*u)*.19;
    return q;
}
vec2 cradleWind(float i,float u,float t) {
    float offset=(i-1.)*.30;
    vec2 q=bezier(vec2(-8.4,1.35+offset),vec2(-4.4,-3.70+offset),
                  vec2(3.4,-3.18-offset),vec2(8.4,1.85-offset),u);
    q.y+=sin(u*TAU*1.6+i*.8-t*.28)*sin(PI*u)*.27;
    return q;
}
vec2 flowingWind(float i,float u,float t) {
    float y=(i-1.)*1.18+.36;
    return vec2(-8.5+u*17.,y+sin(u*TAU*1.10+i*.77-t*.22)*(.57+i*.06)
                +.18*sin(u*TAU*2.5-t*.17+i));
}
vec2 orbitWind(float i,float u,float t) {
    float a=u*TAU*1.26+i*TAU/3.+t*.035,r=.55+u*5.65;
    return rotate(-.08)*vec2(cos(a)*r,sin(a)*r*.46)+vec2(0.,.45);
}
vec2 closingWind(float i,float u,float t) {
    float offset=(i-1.)*.23;
    vec2 q=bezier(vec2(-8.4,-.32+offset),vec2(-4.4,-3.30+offset),
                  vec2(4.4,-3.30-offset),vec2(8.4,-.32-offset),u);
    q.y+=.14*sin(u*TAU*2.-t*.16+i)*sin(PI*u); return q;
}
vec2 windPoint(float i,float u,float t) {
    if(t<12.) return openingWind(i,u);
    if(t<20.) return mix(openingWind(i,u),cradleWind(i,u,t),ease(12.,20.,t));
    if(t<42.) return cradleWind(i,u,t);
    if(t<51.) return mix(cradleWind(i,u,t),flowingWind(i,u,t),ease(42.,51.,t));
    if(t<64.) return flowingWind(i,u,t);
    if(t<73.) return mix(flowingWind(i,u,t),orbitWind(i,u,t),ease(64.,73.,t));
    if(t<78.) return orbitWind(i,u,t);
    if(t<94.) return mix(orbitWind(i,u,t),cradleWind(i,u,t),ease(78.,94.,t));
    if(t<96.) return cradleWind(i,u,t);
    return mix(cradleWind(i,u,t),closingWind(i,u,t),ease(96.,110.,t));
}
void winds(inout vec3 c,vec2 p,float t,float aa) {
    if(abs(p.y)>3.45) return;
    // Outside the orbital chapter, every wind has the same strictly increasing
    // cubic x coordinate. Locate the first possibly visible segment without
    // evaluating fifty-two trigonometric curve points for every screen pixel.
    bool monotonic=t<64. || t>=94.;
    vec4 xPolynomial=vec4(-8.4,12.,11.4,-6.6);
    if(t<20.) xPolynomial=mix(vec4(-8.4,15.6,-10.2,11.4),xPolynomial,ease(12.,20.,t));
    else if(t<64.) xPolynomial=mix(xPolynomial,vec4(-8.5,17.,0.,0.),ease(42.,51.,t));
    else if(t>=96.) xPolynomial=mix(xPolynomial,vec4(-8.4,12.,14.4,-9.6),ease(96.,110.,t));
    for(int j=0;j<3;j++) {
        float i=float(j),start=.6+i*.72,draw=ease(start,start+6.2,t);
        if(draw<.001) continue;
        int first=1;
        if(monotonic) {
            int low=1,high=52;
            for(int search=0;search<6;search++) {
                int middle=(low+high)/2;
                float u=float(middle)/52.*draw;
                float x=xPolynomial.x+u*(xPolynomial.y+u*(xPolynomial.z+u*xPolynomial.w));
                // The extra millimeter covers reassociation of the polynomial;
                // the original segment box below remains the final test.
                if(x<p.x-.501) low=middle+1; else high=middle;
            }
            first=low;
        }
        float distance=20.,signedDistance=20.,nearest=0.;
        vec2 previous=windPoint(i,float(first-1)/52.*draw,t);
        vec2 blockEnd=previous;
        int skipThrough=0;
        for(int k=1;k<=52;k++) {
            int sampleIndex=first+k-1;
            if(sampleIndex>52 || (monotonic && previous.x>p.x+.50)) break;
            if(sampleIndex<=skipThrough) continue;
            int block=(sampleIndex-1)/4;
            if(!monotonic && sampleIndex==block*4+1) {
                blockEnd=windPoint(i,float(sampleIndex+3)/52.*draw,t);
                // |f''| <= (500, 270) for the orbit and both blended winds.
                // The chord error on a four-segment interval is M*h*h/8;
                // this box contains every original interior sample and its
                // half-unit filament bounds, including during both morphs.
                vec2 margin=vec2(.50)+vec2(500.,270.)*(draw*draw/1352.);
                vec2 low=min(previous,blockEnd)-margin,high=max(previous,blockEnd)+margin;
                if(p.x<low.x || p.x>high.x || p.y<low.y || p.y>high.y) {
                    previous=blockEnd; skipThrough=sampleIndex+3; continue;
                }
            }
            float u=float(sampleIndex)/52.*draw;
            vec2 current=(!monotonic && sampleIndex==block*4+4)?blockEnd:windPoint(i,u,t);
            vec2 lo=min(previous,current)-.50,hi=max(previous,current)+.50;
            if(p.x>=lo.x && p.x<=hi.x && p.y>=lo.y && p.y<=hi.y) {
                vec2 edge=current-previous; float len=max(length(edge),.00001);
                float along=sat(dot(p-previous,edge)/(len*len)); vec2 delta=p-mix(previous,current,along);
                float candidate=length(delta);
                if(candidate<distance) {
                    distance=candidate; signedDistance=(delta.x*edge.y-delta.y*edge.x)/len;
                    nearest=(float(sampleIndex)-1.+along)/52.*draw;
                }
            }
            previous=current;
        }
        if(distance>.49) continue;
        float taper=pow(max(0.,sin(PI*sat(nearest/max(draw,.001)))),.55);
        float width=.12+.28*taper,spacing=width/6.;
        float braid=signedDistance+.025*sin(nearest*45.-t*1.10+i*2.)*taper;
        float fine=repeatedLine(braid,spacing,6.);
        float envelope=1.-ease(width*.82,width+spacing,distance);
        float strand=clamp(braid/max(width,.001),-1.,1.);
        vec3 hue=mix(CYAN,j==1?MAGENTA:VIOLET,.5+.5*strand);
        float packet=pow(.5+.5*cos(nearest*TAU*3.-t*.72+i*2.),28.);
        c+=hue*fill(fine-(.0035+.003*packet),aa)*envelope*taper*(.29+.53*packet);
        c+=hue*exp(-distance*distance/(width*width)*2.7)*taper*.035;
        glowLine(c,abs(braid),.008,mix(j==1?GOLD:CYAN,PAPER,.13),(.55+.48*packet)*taper,aa);
    }
}

// Polar and elliptical fields add detailed orbital lace analytically. Their
// repeated bands cost one distance evaluation regardless of the line count.
void soulFiligree(inout vec3 c,vec2 p,float t,float aa) {
    float presence=max(ease(14.,22.,t)*(1.-ease(43.,46.,t)),ease(85.,94.,t));
    if(presence<.001) return;
    float framing=ease(104.,110.,t),scale=mix(1.,.43,framing);
    vec2 center=mix(nucleus(t),vec2(0.,2.03),framing),q=(p-center)/scale;
    float r=length(q); if(r>3.45) return;
    float a=atan(q.y,q.x),breathe=.05*sin(t*.37);
    float rose=1.42+.30*cos(7.*a-t*.10)+.13*sin(3.*a+t*.17)+breathe;
    float derivative=-2.1*sin(7.*a-t*.10)+.39*cos(3.*a+t*.17);
    float radial=(r-rose)/sqrt(1.+derivative*derivative/max(r*r,.10));
    float lace=repeatedLine(radial,.053,5.)*scale;
    float envelope=1.-ease(.24,.34,abs(radial));
    c+=mix(VIOLET,MAGENTA,.5+.5*sin(a*2.+t*.08))*fill(lace-.0035,aa)*envelope*presence*.36;
    for(int j=0;j<3;j++) {
        float i=float(j); vec2 e=rotate(i*PI/3.+t*.027)*q;
        float flatten=.42+i*.055; e.y/=flatten;
        float er=length(e),d=(er-2.62)/mix(1./flatten,1.,abs(e.x)/max(er,.001));
        float lines=repeatedLine(d,.062,3.)*scale;
        float mask=1.-ease(.18,.26,abs(d));
        vec3 hue=j==0?CYAN:(j==1?VIOLET:MAGENTA);
        c+=hue*fill(lines-.003,aa)*mask*presence*.27;
        glowLine(c,abs(d)*scale,.006,mix(hue,PAPER,.18),presence*.28,aa);
    }
    float ring=repeatedLine(r-.48,.055,2.)*scale;
    c+=GOLD*fill(ring-.0045,aa)*(1.-ease(.11,.18,abs(r-.48)))*presence*.54;
}
vec2 meteorPosition(float time) {
    if(time<=43.) {
        float u=sat((time-32.)/11.);
        return bezier(vec2(-9.4,5.3),vec2(-6.6,4.0),vec2(-2.,1.10),vec2(0.,.45),u);
    }
    return bezier(vec2(0.,.45),vec2(2.3,-.16),vec2(7.,-2.),vec2(11.,-4.7),sat((time-43.)/5.));
}
void meteor(inout vec3 c,vec2 p,float t,float aa) {
    if(t<32. || t>49.) return;
    vec2 head=meteorPosition(t),previous=head;
    float visible=1.-ease(46.5,49.,t),distance=20.,signedDistance=20.,nearest=0.;
    // Both joined Beziers are monotone in x and y, so the two tail endpoints
    // enclose every sample, even when the tail crosses the impact at 43 s.
    vec2 tail=meteorPosition(t-5.4),low=min(head,tail)-.43,high=max(head,tail)+.43;
    if(p.x>=low.x && p.x<=high.x && p.y>=low.y && p.y<=high.y) {
      for(int k=1;k<=28;k++) {
        float u=float(k)/28.; vec2 current=meteorPosition(t-u*5.4);
        vec2 lo=min(previous,current)-.43,hi=max(previous,current)+.43;
        if(p.x>=lo.x && p.x<=hi.x && p.y>=lo.y && p.y<=hi.y) {
            vec2 edge=current-previous; float len=max(length(edge),.00001);
            float along=sat(dot(p-previous,edge)/(len*len)); vec2 delta=p-mix(previous,current,along);
            float candidate=length(delta);
            if(candidate<distance) {
                distance=candidate; signedDistance=(delta.x*edge.y-delta.y*edge.x)/len;
                nearest=(float(k)-1.+along)/28.;
            }
        }
        previous=current;
      }
    }
    if(distance<.42) {
        float taper=pow(1.-nearest,1.1),spread=.018+.042*sin(PI*nearest);
        float braid=signedDistance+.035*sin(nearest*22.-t*2.)*sin(PI*nearest);
        float threads=repeatedLine(braid,spread,4.);
        float mask=1.-ease(spread*3.4,spread*4.5,distance);
        c+=mix(CYAN,MAGENTA,.5+.5*sat(braid/.20))*fill(threads-.005,aa)*mask*taper*visible*.95;
        glowLine(c,abs(braid),.010+.032*taper,mix(GOLD,PAPER,.57),(1.+1.15*taper)*visible,aa);
    }
    float radius=length(p-head);
    if(radius<.85) c+=PAPER*visible*(2.8*fill(radius-.072,aa)+.58*exp(-radius*12.));
    float age=t-43.;
    if(age>=0. && age<3.4) {
        vec2 q=p-vec2(0.,.45); float r=length(q),energy=1.-ease(.1,3.4,age);
        float ring=repeatedLine(r-(.20+age*3.25),.11,2.);
        if(abs(r-(.20+age*3.25))<.42) glowLine(c,ring,.013,mix(CYAN,GOLD,.42),energy*.70,aa);
        c+=PAPER*exp(-age*age*9.)*1.2*exp(-r*r*.82);
    }
}
void coreLight(inout vec3 c,vec2 p,float t,float aa) {
    float presence=max(ease(12.,20.,t)*(1.-ease(43.,45.,t)),ease(84.,94.,t));
    float framing=ease(104.,110.,t); vec2 at=mix(nucleus(t),vec2(0.,2.03),framing),q=p-at;
    float radius=length(q); if(radius>3.2) return;
    c+=GOLD*presence*(.32*exp(-radius*radius*2.7)+.035*exp(-radius*radius*.30));
    float size=mix(.085,.060,framing);
    c+=PAPER*presence*(2.2*fill(radius-size,aa)+.38*exp(-radius*18.));
    float rays=exp(-abs(q.x)*95.)*exp(-abs(q.y)*6.)+exp(-abs(q.y)*95.)*exp(-abs(q.x)*6.);
    c+=mix(GOLD,PAPER,.35)*rays*presence*.62;
    c+=PAPER*exp(-pow((t-94.)/.65,2.))*.48*exp(-radius*radius*.35);
}
void reunionTrails(inout vec3 c,vec2 p,float t,float aa) {
    if(t<46. || t>94.) return;
    for(int j=0;j<24;j++) {
        float i=float(j),start=gatherStart(i),arrival=start+7.;
        if(t>arrival || (t>78. && t<start)) continue;
        vec2 head=pieceCenter(i,t),q=p-head;
        if(max(abs(q.x),abs(q.y))>2.7) continue;
        // A drifting seed can move only this far during its 2.25-second tail.
        // The fade-in derivative is at most 1.5/7; after it finishes the
        // tighter velocity bound applies. The full 0.17 glow radius is kept.
        if(t>=52.25 && t<=64.) {
            float fadeSpeed=t<59.25?1.5/7.:0.;
            vec2 reach=vec2(.66*(.20+fadeSpeed),.34*(.23+fadeSpeed))*2.25+.17;
            if(abs(q.x)>reach.x || abs(q.y)>reach.y) continue;
        }
        vec2 gatherFrom=vec2(0.),gatherC1=vec2(0.),gatherC2=vec2(0.),destination=vec2(0.);
        if(t>=start) {
            // These control points depend on the piece and its scheduled
            // departure, never on the ten samples along the current trail.
            destination=vec2(0.,.45)+crownCenter(i);
            gatherFrom=driftPosition(i,start);
            float side=mod(i,2.)<.5?-1.:1.;
            gatherC1=rotate(side*.75)*(gatherFrom-vec2(0.,.45))*.95+vec2(0.,.45);
            gatherC2=destination+rotate(side*.82)*(destination-vec2(0.,.45))*1.12;
        }
        if(t>=66.25 && t<start) {
            float speed=.17+hash(i+8.)*.055,radius=1.7+mod(i,8.)*.59;
            float angle=i*2.399963+.30+(t-64.)*speed,tailAngle=angle-2.25*speed;
            vec2 orbitHead=vec2(cos(angle),sin(angle)*.47)*radius+vec2(0.,.45);
            vec2 orbitTail=vec2(cos(tailAngle),sin(tailAngle)*.47)*radius+vec2(0.,.45);
            vec2 margin=vec2(1.,.47)*(radius*speed*speed*2.25*2.25/8.);
            vec2 orbitLow=min(orbitHead,orbitTail)-margin,orbitHigh=max(orbitHead,orbitTail)+margin;
            vec2 drift=burstTarget(i),driftLow=drift-vec2(.66,.34),driftHigh=drift+vec2(.66,.34);
            float firstMix=ease(64.,73.,t-2.25),lastMix=ease(64.,73.,t);
            vec2 low=min(mix(driftLow,orbitLow,firstMix),mix(driftLow,orbitLow,lastMix))-.17;
            vec2 high=max(mix(driftHigh,orbitHigh,firstMix),mix(driftHigh,orbitHigh,lastMix))+.17;
            if(p.x<low.x || p.x>high.x || p.y<low.y || p.y>high.y) continue;
        }
        if(t>=start+2.25) {
            float a=ease(start,arrival,t-2.25),b=ease(start,arrival,t),span=b-a;
            vec2 tail=bezier(gatherFrom,gatherC1,gatherC2,destination,a);
            vec2 first=tail+span*((1.-a)*(1.-a)*(gatherC1-gatherFrom)
                +2.*(1.-a)*a*(gatherC2-gatherC1)+a*a*(destination-gatherC2));
            vec2 last=head-span*((1.-b)*(1.-b)*(gatherC1-gatherFrom)
                +2.*(1.-b)*b*(gatherC2-gatherC1)+b*b*(destination-gatherC2));
            vec2 low=min(min(head,tail),min(first,last))-.17;
            vec2 high=max(max(head,tail),max(first,last))+.17;
            if(p.x<low.x || p.x>high.x || p.y<low.y || p.y>high.y) continue;
        }
        float distance=20.,nearest=0.; vec2 previous=head;
        for(int k=1;k<=10;k++) {
            float u=float(k)/10.,past=max(43.,t-u*2.25);
            vec2 current=past>=start?bezier(gatherFrom,gatherC1,gatherC2,destination,ease(start,arrival,past)):pieceCenter(i,past);
            float candidate=segment(p,previous,current);
            if(candidate<distance) { distance=candidate; nearest=u; }
            previous=current;
        }
        if(distance>.17) continue;
        float strength=(1.-nearest)*ease(46.,50.,t)*(1.-ease(arrival-.8,arrival,t));
        float fine=repeatedLine(distance,.029,2.);
        c+=storyPieceColor(i)*fill(fine-.003,aa)*(1.-ease(.06,.09,distance))*strength*.35;
        glowLine(c,distance,.006,storyPieceColor(i),strength*.68,aa);
    }
}
// Seventy-two small comet seeds are instanced on three orbital bands. The
// nearest angular cell is reconstructed instead of evaluating all emitters.
void cometSeeds(inout vec3 c,vec2 p,float t,float aa) {
    if(t<43. || t>94.) return;
    float born=ease(43.,48.,t),reunion=1.-ease(80.,94.,t);
    vec2 q=p-vec2(0.,.45),e=q/vec2(1.,.47); float angle=atan(e.y,e.x);
    for(int j=0;j<3;j++) {
        float band=float(j),speed=.13+band*.041,turn=(t-43.)*speed+band*.73;
        float cell=floor((angle-turn)/TAU*24.+.5),a=cell*TAU/24.+turn;
        float id=mod(cell,24.)+band*24.,radius=(2.25+band*1.58+.26*sin(id*2.1+t*.13))*born;
        vec2 at=vec2(cos(a)*radius,sin(a)*radius*.47),delta=q-at;
        if(max(abs(delta.x),abs(delta.y))>.62) continue;
        vec2 tangent=normalize(vec2(-sin(a),cos(a)*.47));
        vec2 local=vec2(dot(delta,tangent),dot(delta,vec2(-tangent.y,tangent.x)));
        float lengthTail=.17+hash(id+3.)*.32;
        float u=sat(-local.x/lengthTail),curve=.12*u*u;
        float d=length(vec2(max(local.x,0.)+min(local.x+lengthTail,0.),local.y-curve));
        vec3 hue=storyPieceColor(id);
        glowLine(c,d,.004,hue,born*reunion*(1.-u)*.64,aa);
        c+=mix(hue,PAPER,.55)*fill(length(delta)-.013,aa)*born*reunion*1.05;
    }
}
void depthThreads(inout vec3 c,vec2 p,float t,float aa) {
    vec2 q=rotate(-.105)*p;
    float wave=.36*sin(q.x*.44-t*.055)+.14*sin(q.x*.89+t*.06);
    float d=q.y-wave-.30,spacing=.43;
    float thread=clamp(floor(d/spacing+.5),-7.,7.);
    float distance=abs(d-thread*spacing)/1.07;
    float envelope=exp(-q.x*q.x*.018)*(1.-ease(2.5,3.6,abs(q.y)));
    float rhythm=.48+.52*pow(.5+.5*cos(q.x*.65-t*.12+thread*.63),3.);
    c+=mix(CYAN,VIOLET,.5+.5*sin(thread*.8))*fill(distance-.0025,aa)*envelope*rhythm*.075;
}
void stardust(inout vec3 c,vec2 p,float t,float aa) {
    vec2 cell=floor((p+vec2(8.,4.5))/.79),base=(cell+.5)*.79-vec2(8.,4.5);
    float id=cell.x+cell.y*31.,h=hash(id+2.3);
    if(h<.30) return;
    vec2 at=base+vec2(hash(id+23.)-.5,hash(id+46.)-.5)*.55;
    at+=vec2(.025*sin(t*.08+id),.025*cos(t*.10+id));
    vec2 q=p-at; if(max(abs(q.x),abs(q.y))>.11) return;
    float r=length(q),pulse=.60+.40*sin(t*.42+id*1.7);
    vec3 hue=mix(CYAN,PAPER,h);
    c+=hue*pulse*(fill(r-(.004+h*.006),aa)*.37+.025*exp(-r*34.));
    if(h>.93) c+=hue*pulse*.18*(exp(-abs(q.x)*180.-abs(q.y)*48.)+exp(-abs(q.y)*180.-abs(q.x)*48.));
}
vec3 space(vec2 p,float t) {
    vec3 c=vec3(.006,.010,.028);
    c+=vec3(.008,.029,.046)*exp(-dot(p-vec2(-2.,.5),p-vec2(-2.,.5))*.055);
    c+=vec3(.028,.006,.042)*exp(-dot(p-vec2(3.,.7),p-vec2(3.,.7))*.08);
    c+=vec3(.019,.009,.034)*ease(78.,96.,t)*exp(-dot(p,p)*.13);
    return c;
}

float sdfSample(vec2 q,vec4 tile) {
    q.y=1.-q.y;
    vec2 pix=clamp(tile.xy+q*tile.zw-.5,tile.xy,tile.xy+tile.zw-1.);
    vec2 b=floor(pix),f=fract(pix);
    float a=texture2D(TEXTURE_2,(b+vec2(.5,.5))/4096.).r;
    float b0=texture2D(TEXTURE_2,(b+vec2(1.5,.5))/4096.).r;
    float c0=texture2D(TEXTURE_2,(b+vec2(.5,1.5))/4096.).r;
    float d=texture2D(TEXTURE_2,(b+vec2(1.5,1.5))/4096.).r;
    return (mix(mix(a,b0,f.x),mix(c0,d,f.x),f.y)-.5)*48.;
}
void letter(inout vec3 c,vec2 p,vec2 at,vec2 size,vec4 tile,vec3 hue,float opacity,float aa) {
    vec2 q=(p-at)/size+.5; if(min(q.x,q.y)<.003 || max(q.x,q.y)>.997) return;
    float d=sdfSample(q,tile),edge=clamp(.5*fwidth(d),.55,8.);
    c=mix(c,hue,smoothstep(-edge,edge,d)*opacity);
}
// Closed contour correspondence, stored in the existing atlas' lower half.
// All loops are fixed-budget; each glyph rejects its screen box before reads.
mat2 vmRot(float angle) {
    return mat2(cos(angle),-sin(angle),sin(angle),cos(angle));
}
void vmPaint(inout vec3 c,vec3 hue,float coverage) {
    c = mix(c, hue, coverage);
}
float vmSdfCoverage(vec2 q,vec4 tile) {
    float distance=sdfSample(q,tile);
    float edge=clamp(0.5*fwidth(distance),0.55,12.0);
    return smoothstep(-edge,edge,distance);
}
void vectorStaticGlyph(inout vec3 c,vec2 p,vec2 a,vec2 sa,vec4 ta,
                       vec2 b,vec2 sb,vec4 tb,float u,float arc,
                       vec3 hue,float opacity,float aa) {
    float lift=sin(3.14159265359*u);
    vec2 center=mix(a,b,u)+vec2(arc*0.21,arc)*lift;
    vec2 size=max(mix(sa,sb,u),vec2(0.00001));
    vec2 local=vmRot(lift*arc*0.16)*(p-center);
    vec2 q=local/size+0.5;
    if(min(q.x,q.y)<0.005 || max(q.x,q.y)>0.995 || opacity<0.001) return;
    vmPaint(c,hue,opacity*vmSdfCoverage(q,ta));
}
vec2 vmReadPoint(float index) {
    vec2 pixel=vec2(mod(index,4096.0),floor(index/4096.0));
    vec4 bytes=floor(texture2D(TEXTURE_2,(pixel+0.5)/4096.0)*255.0+0.5);
    return vec2(bytes.r*256.0+bytes.g,bytes.b*256.0+bytes.a)/65535.0;
}
void vectorGlyph(inout vec3 c,vec2 p,vec2 a,vec2 sa,vec4 ta,
                 vec2 b,vec2 sb,vec4 tb,float u,float arc,
                 vec3 hue,float opacity,float aa,vec2 data,vec2 present) {
    if(opacity<0.001) return;
    if(u<=0.0) {
        if(present.x>0.5) vectorStaticGlyph(c,p,a,sa,ta,a,sa,ta,0.0,0.0,hue,opacity,aa);
        return;
    }
    if(u>=1.0) {
        if(present.y>0.5) vectorStaticGlyph(c,p,b,sb,tb,b,sb,tb,0.0,0.0,hue,opacity,aa);
        return;
    }
    float lift=sin(3.14159265359*u);
    vec2 center=mix(a,b,u)+vec2(arc*0.21,arc)*lift;
    vec2 size=max(mix(sa,sb,u),vec2(0.00001));
    vec2 local=vmRot(lift*arc*0.16)*(p-center);
    vec2 q=local/size+0.5;
    if(min(q.x,q.y)<0.005 || max(q.x,q.y)>0.995) return;
    float distanceSquared=1e8;
    float winding=0.0;
    float fanArea=0.0;
    float coverage=0.0;
    float componentOuter=0.0;
    float componentHoles=0.0;
    float edge=max(aa*0.55,0.00001);
    vec2 previous=vec2(0.0);
    vec2 origin=vec2(0.0);
    bool connected=false;
    for(int i=0;i<256;i++) {
        if(float(i)>=data.y) break;
        float address=data.x+float(i)*2.0;
        vec2 first=vmReadPoint(address);
        vec2 second=vmReadPoint(address+1.0);
        if(first.x>0.99999 && first.y>0.99999) {
            float signedDistance=sqrt(distanceSquared)*(abs(winding)>0.5?1.0:-1.0);
            // Zero-area paths have no ink, including their AA footprint.
            // Absolute triangle fan area also handles self-intersecting loops
            // whose signed lobes would otherwise cancel and flash off.
            float loopCoverage=smoothstep(-edge,edge,signedDistance)
                *smoothstep(0.0,edge*edge,fanArea);
            if(second.x<0.5) {
                coverage=max(coverage,componentOuter*(1.0-componentHoles));
                componentOuter=loopCoverage;
                componentHoles=0.0;
            } else {
                componentHoles=max(componentHoles,loopCoverage);
            }
            distanceSquared=1e8;
            winding=0.0;
            fanArea=0.0;
            connected=false;
            continue;
        }
        vec2 current=(mix(first,second,u)-0.5)*size;
        if(connected) {
            vec2 segment=current-previous;
            vec2 relative=local-previous;
            float lengthSquared=dot(segment,segment);
            if(lengthSquared>1e-16) {
                float along=clamp(dot(relative,segment)/lengthSquared,0.0,1.0);
                vec2 delta=relative-along*segment;
                distanceSquared=min(distanceSquared,dot(delta,delta));
                float side=segment.x*relative.y-segment.y*relative.x;
                if(previous.y<=local.y && current.y>local.y && side>0.0) winding+=1.0;
                if(previous.y>local.y && current.y<=local.y && side<0.0) winding-=1.0;
                vec2 firstArm=previous-origin;
                vec2 secondArm=current-origin;
                fanArea+=0.5*abs(firstArm.x*secondArm.y-firstArm.y*secondArm.x);
            }
        } else {
            origin=current;
        }
        previous=current;
        connected=true;
    }
    coverage=max(coverage,componentOuter*(1.0-componentHoles));
    // Only endpoint AA is reconciled; unrelated glyph distance fields never mix.
    if(u<0.025 && present.x>0.5)
        coverage=mix(vmSdfCoverage(q,ta),coverage,smoothstep(0.0,0.025,u));
    if(u>0.975 && present.y>0.5)
        coverage=mix(coverage,vmSdfCoverage(q,tb),smoothstep(0.975,1.0,u));
    vmPaint(c,hue,coverage*opacity);
}


return sqrt(d)*winding;
}

float gust(float t) { return sin(t*1.08)+.30*sin(t*2.61+.8); }
vec3 sky(vec2 p,float t) {
    float h=sat((p.y+3.7)/7.5);
    vec3 c=mix(vec3(.065,.17,.22),vec3(.042,.055,.125),h);
    vec2 haze=p-vec2(-2.8,1.2);
    c+=vec3(.055,.115,.12)*exp(-dot(haze,haze)*.052);
    c+=vec3(.045,.021,.025)*exp(-dot(p-vec2(3.,.3),p-vec2(3.,.3))*.07)*ease(85.,110.,t);
    return c;
}
void stars(inout vec3 c,vec2 p,float t,float aa) {
    float presence=max(1.-ease(2.,13.,t),ease(88.,111.,t));
    for(int j=0;j<61;j++) {
        float i=float(j),h=hash(i+7.);
        vec2 at=vec2(hash(i+1.2)*16.6-8.3,-.1+hash(i*3.4+8.)*3.65);
        float radius=(.008+h*.008)*mix(.15,1.,ease(h*.60,h*.60+.32,presence));
        float pulse=.70+.30*sin(t*.46+i*2.2),d=length(p-at);
        c+=mix(PAPER,GOLD,h)*pulse*(fill(d-radius,aa)*(.18+.56*presence)+.010*exp(-d*15.));
    }
}
void seed(inout vec3 c,vec2 p,vec2 at,float r,float t,float aa) {
    vec2 q=rotate(.32*sin(t*.7))*(p-at);
    float d=ellipse(q,vec2(r*.70,r));
    c+=GOLD*(.19*exp(-dot(q,q)/(r*r*22.))+.023*exp(-length(q)*1.9));
    paint(c,d,mix(GOLD,PAPER,.35),1.,aa);
    inkCurve(c,q,vec2(-r*.20,-r*.66),vec2(r*.26,-r*.16),vec2(-r*.08,r*.25),vec2(r*.14,r*.70),r*.055,PAPER,.9,aa);
}

// Six-head figure, curved profile and hands, broad skirt and leather boots.
void girl(inout vec3 c,vec2 p,vec2 at,float size,float t,float wind,float aa) {
    vec2 q=(p-at)/size; float a=aa/size;
    if(q.x< -1.75 || q.x>1.2 || q.y<-.12 || q.y>3.15) return;
    q.x-=.018*sin(t*1.25)*sat(q.y/3.);
    vec2 cloth=q;
    cloth.x-=wind*.11*sin(t*2.6+q.y*3.)*sat((2.3-q.y)/1.7);
    paint(c,art_cape(cloth),CORAL,1.,a);
    paint(c,art_capeShade(cloth),vec3(.48,.18,.21),1.,a);
    paint(c,art_capeFold(cloth),vec3(.80,.38,.30),.7,a);
    paint(c,art_backBoot(q),vec3(.17,.16,.19),1.,a);
    paint(c,art_frontBoot(q),vec3(.21,.19,.21),1.,a);
    paint(c,art_dress(q),vec3(.17,.30,.34),1.,a);
    paint(c,art_dressLight(q),vec3(.26,.42,.43),1.,a);
    inkCurve(c,q,vec2(-.11,1.65),vec2(-.15,1.21),vec2(-.08,.83),vec2(-.04,.50),.008,MIST,.6,a);
    inkCurve(c,q,vec2(-.27,1.16),vec2(-.30,.90),vec2(-.40,.71),vec2(-.43,.57),.007,MIST,.32,a);
    inkCurve(c,q,vec2(-.52,.61),vec2(-.27,.46),vec2(.15,.44),vec2(.37,.58),.012,GOLD,.75,a);
    paint(c,art_neck(q),vec3(.76,.57,.45),1.,a);
    paint(c,art_farSleeve(q),vec3(.48,.22,.23),1.,a);
    paint(c,art_face(q),vec3(.87,.70,.54),1.,a);
    paint(c,ellipse(q-vec2(.12,2.53),vec2(.054,.025)),vec3(.84,.51,.41),.38,a);
    vec2 hair=q; hair.x-=wind*.052*sin(t*2.1+q.y*7.)*sat((2.85-q.y)*2.);
    paint(c,art_hair(hair),vec3(.105,.115,.175),1.,a);
    paint(c,art_hairLight(hair),vec3(.23,.29,.33),.85,a);
    inkCurve(c,hair,vec2(.12,2.88),vec2(-.20,3.03),vec2(-.30,2.70),vec2(-.27,2.52),.009,vec3(.40,.43,.42),.75,a);
    inkCurve(c,hair,vec2(-.25,2.63),vec2(-.31,2.32),vec2(-.57,2.25),vec2(-.78,2.23),.008,MIST,.45,a);
    inkCurve(c,q,vec2(.16,2.69),vec2(.18,2.70),vec2(.20,2.70),vec2(.213,2.68),.009,INK,.9,a);
    inkCurve(c,q,vec2(.205,2.50),vec2(.215,2.50),vec2(.225,2.50),vec2(.232,2.51),.006,vec3(.51,.29,.26),.8,a);
    paint(c,art_sleeve(q),CORAL,1.,a);
    paint(c,art_hand(q),vec3(.88,.71,.55),1.,a);
    inkCurve(c,q,vec2(.46,1.91),vec2(.48,1.88),vec2(.50,1.85),vec2(.52,1.84),.011,GOLD,.85,a);
    inkCurve(c,cloth,vec2(-.16,2.21),vec2(-.34,1.83),vec2(-.40,1.24),vec2(-.94,.78),.009,GOLD,.67,a);
    paint(c,ellipse(q-vec2(.035,2.22),vec2(.035,.029)),GOLD,1.,a);
}

float landHeight(float x,float layer,float cloud,float t) {
    float base=-2.72+layer*.46;
    float hills=.27*sin(x*.43+layer*1.8)+.14*sin(x*.81-layer*.9);
    float waves=.16*sin(x*.56-t*.10+layer)+.07*sin(x*1.40+t*.05+layer*2.3);
    float rounded=.30*exp(-pow((mod(x+layer*3.1+t*.13,6.4)-3.2)/1.25,2.));
    return base+mix(hills,waves+rounded,cloud)+cloud*layer*.30;
}
float arch(vec2 p,float width,float height) {
    return min(box(p-vec2(0.,(height-width)*.5),vec2(width,(height-width)*.5)),length(p-vec2(0.,height-width))-width);
}
void house(inout vec3 c,vec2 p,vec2 at,float size,float variant,float lit,float aa) {
    vec2 q=(p-at)/size; float a=aa/size;
    if(abs(q.x)>.76 || q.y<-.08 || q.y>1.8) return;
    vec3 stone=mix(vec3(.21,.32,.35),vec3(.28,.40,.40),variant);
    paint(c,art_house(q),stone,1.,a);
    paint(c,art_houseSide(q),stone*.74,1.,a);
    float roof=variant>.60?art_roofTall(q):art_roof(q);
    paint(c,roof,mix(vec3(.12,.25,.30),vec3(.18,.32,.35),variant),1.,a);
    paint(c,abs(roof)-.009,MIST,.44,a);
    inkCurve(c,q,vec2(-.62,.80),vec2(-.30,.78),vec2(.23,.81),vec2(.60,.83),.009,GOLD,.43,a);
    float doorway=arch(q-vec2(-.20,.02),.086,.40);
    paint(c,doorway,vec3(.08,.15,.20),1.,a);
    paint(c,abs(doorway)-.009,MIST,.35,a);
    float window=arch(q-vec2(.28,.43),.070,.23);
    paint(c,window,mix(vec3(.28,.39,.37),GOLD,lit*.82+.12),1.,a);
    paint(c,segment(q,vec2(.28,.45),vec2(.28,.65))-.008,stone*.75,1.,a);
    paint(c,segment(q,vec2(.22,.54),vec2(.34,.54))-.007,stone*.75,1.,a);
    paint(c,ellipse(q-vec2(-.035,1.02+variant*.10),vec2(.055,.065)),GOLD,.25+.6*lit,a);
    paint(c,segment(q,vec2(-.41,.12),vec2(-.40,.72))-.010,MIST,.25,a);
    paint(c,segment(q,vec2(-.46,.30),vec2(.43,.31))-.006,MIST,.15,a);
    c+=GOLD*lit*.027*exp(-dot(q-vec2(.28,.54),q-vec2(.28,.54))*16.);
}
void cloudCurl(inout vec3 c,vec2 p,vec2 at,float radius,vec3 hue,float power,float aa) {
    vec2 q=p-at;
    if(abs(q.x)>radius*1.8 || abs(q.y)>radius*1.3) return;
    vec2 previous=vec2(-radius*1.65,-radius*.23); float distance=20.;
    for(int k=0;k<=24;k++) {
        float u=float(k)/24.,theta=-PI*.16+u*PI*1.84,r=radius*(1.-u*.77);
        vec2 current=vec2(-cos(theta)*r,sin(theta)*r*.65);
        distance=min(distance,segment(q,previous,current)); previous=current;
    }
    paint(c,distance-.009,hue,power,aa);
}
void landscape(inout vec3 c,vec2 p,float t,float cloud,float aa) {
    float travel=ease(28.,36.,t)*(1.-ease(100.,111.,t));
    float lit=.04+.88*ease(100.,111.,t);
    for(int k=0;k<4;k++) {
        float layer=3.-float(k),top=landHeight(p.x,layer,cloud,t);
        vec3 hue=mix(vec3(.075,.18,.235),vec3(.16,.32,.34),layer/3.);
        hue=mix(hue,vec3(.15,.34,.36)+layer*.016,cloud*.56);
        paint(c,p.y-top,hue,1.,aa);
        paint(c,abs(p.y-top)-.008,MIST,.15+cloud*.17,aa);
        if(k==0 || k==2) {
            for(int j=0;j<7;j++) {
                float i=float(j),h=hash(i+layer*3.5),x=-8.8+i*2.67+layer*.64;
                float y=landHeight(x,layer,cloud,t)-.05-travel*5.5;
                house(c,p,vec2(x,y),(.43+h*.22)*(1.+(3.-layer)*.21),h,lit,aa);
            }
        }
        for(int j=0;j<3;j++) {
            float x=-6.7+float(j)*6.1-layer*.8+sin(t*.05)*.28;
            cloudCurl(c,p,vec2(x,landHeight(x,layer,cloud,t)-.18),.54+layer*.15,MIST,cloud*.38,aa);
        }
    }
    float road=curve(p,vec2(-4.8,-3.5),vec2(-.8,-2.8),vec2(-5.,-2.9),vec2(-2.6,-2.25),1.);
    paint(c,road-.043,vec3(.32,.42,.40),(1.-travel)*.40,aa);
}

vec2 boatCenter(float t) { return vec2(-1.75+sat((t-34.)/20.)*3.,-.38+.13*sin((t-34.)*.42)); }
void treeControls(float i,out vec2 a,out vec2 b,out vec2 cc,out vec2 d) {
    if(i<.5) { a=vec2(.02,-2.42); b=vec2(-.22,-1.05); cc=vec2(.43,.91); d=vec2(.18,2.55); return; }
    float j=i-1.,side=mod(j,2.)<.5?-1.:1.,level=floor(j*.5),h=hash(i+8.);
    float rootY=-1.49+level*.40;
    a=vec2(.08+.07*sin(rootY*1.8),rootY);
    d=vec2(side*(2.83-level*.21+h*.37),-.25+level*.34+h*.41);
    b=a+vec2(side*(.64-level*.025),.12+.24*h);
    cc=d-vec2(side*(.48+.25*h),.62+level*.028);
}
vec2 starPosition(float i) { return vec2(-6.9+hash(i+3.7)*13.8,1.42+hash(i+66.)*1.65); }
void motifControls(float stage,float i,float t,out vec2 a,out vec2 b,out vec2 cc,out vec2 d) {
    if(stage<1.5) {
        if(i<6.) {
            float y=1.56+i*.21;
            a=vec2(-9.,y-.28); b=vec2(-3.2,y+1.45+.18*sin(t*.18+i));
            cc=vec2(1.3,y-1.38); d=vec2(9.,y+.15);
        } else {
            float theta=(i-6.)*.29+.1,r=.75+(i-6.)*.075;
            vec2 center=mix(vec2(3.85,1.80),vec2(-1.25,-.40),stage*.55);
            a=center+vec2(cos(theta),sin(theta))*r;
            b=center+vec2(cos(theta+1.),sin(theta+1.))*r*1.32;
            cc=center+vec2(cos(theta+1.6),sin(theta+1.6))*r*.68;
            d=center+vec2(cos(theta+2.3),sin(theta+2.3))*r*.28;
        }
        return;
    }
    if(stage<2.5) {
        vec2 center=boatCenter(t);
        if(i<.5) { a=vec2(-1.57,.17); b=vec2(-.73,-.32); cc=vec2(.05,-.79); d=vec2(1.56,.35); }
        else if(i<1.5) { a=vec2(-1.57,.17); b=vec2(-.56,-.04); cc=vec2(.44,-.12); d=vec2(1.56,.35); }
        else if(i<2.5) { a=vec2(-1.15,.36); b=vec2(-.98,.91); cc=vec2(-.50,1.46); d=vec2(-.05,1.88); }
        else if(i<3.5) { a=vec2(-.05,1.88); b=vec2(-.12,1.24); cc=vec2(-.15,.69); d=vec2(-.13,.16); }
        else if(i<4.5) { a=vec2(-.13,.16); b=vec2(-.49,.21); cc=vec2(-.80,.23); d=vec2(-1.15,.36); }
        else if(i<5.5) { a=vec2(-.02,.10); b=vec2(-.06,.75); cc=vec2(.02,1.35); d=vec2(.03,1.98); }
        else {
            float y=-.72-(i-6.)*.14;
            a=vec2(-9.,y); b=vec2(-3.3,y+1.); cc=vec2(2.7,y-.72); d=vec2(9.,y+.25); return;
        }
        a+=center; b+=center; cc+=center; d+=center; return;
    }
    if(stage<3.5) {
        float trunk=floor(i/3.),twig=mod(i,3.),x=-7.3+trunk*2.83;
        float lean=.48+.13*sin(t*.9+trunk);
        if(twig<.5) { a=vec2(x,-2.75); b=vec2(x-.24,-.40); cc=vec2(x+lean,1.8); d=vec2(x+lean*1.8,4.5); }
        else { float side=twig<1.5?-1.:1.; a=vec2(x+.15,-.3+twig*.6); b=a+vec2(side*.55,.28); cc=a+vec2(side*1.1,1.); d=a+vec2(side*1.3,2.2); }
        return;
    }
    treeControls(i,a,b,cc,d); if(stage<4.5) return;
    vec2 target=starPosition(i),from=d;
    float travel=ease(96.,109.,t),flap=sin(t*4.4+i)*.15;
    vec2 at=mix(from,target,travel)+vec2(sin(travel*PI+i)*.44,sin(travel*PI)*.52);
    if(stage<5.5) { a=at+vec2(-.28,.13+flap); b=at+vec2(-.11,.16+flap); cc=at+vec2(-.10,-.10); d=at; return; }
    a=target; d=starPosition(mod(i+1.,18.)); b=mix(a,d,.333); cc=mix(a,d,.667);
}
void narrativeCurves(inout vec3 c,vec2 p,float t,float aa) {
    float stage=0.,next=0.,u=0.;
    if(t<14.) { stage=0.; next=0.; }
    else if(t<18.) { stage=0.; next=1.; u=ease(14.,18.,t); }
    else if(t<31.) { stage=1.; next=1.; }
    else if(t<37.) { stage=1.; next=2.; u=ease(31.,37.,t); }
    else if(t<50.) { stage=2.; next=2.; }
    else if(t<57.) { stage=2.; next=3.; u=ease(50.,57.,t); }
    else if(t<74.) { stage=3.; next=3.; }
    else if(t<82.) { stage=3.; next=4.; u=ease(74.,82.,t); }
    else if(t<96.) { stage=4.; next=4.; }
    else if(t<103.) { stage=4.; next=5.; u=ease(96.,103.,t); }
    else if(t<108.) { stage=5.; next=5.; }
    else if(t<114.) { stage=5.; next=6.; u=ease(108.,114.,t); }
    else { stage=6.; next=6.; }
    float location=mix(stage,next,u);
    for(int j=0;j<18;j++) {
        float i=float(j); vec2 a,b,cc,d,a0,b0,c0,d0;
        motifControls(stage,i,t,a,b,cc,d); motifControls(next,i,t,a0,b0,c0,d0);
        a=mix(a,a0,u); b=mix(b,b0,u); cc=mix(cc,c0,u); d=mix(d,d0,u);
        float gold=ease(3.1,4.,location),constellation=ease(5.1,6.,location);
        vec3 hue=mix(MIST*.78,GOLD,gold);
        float alpha=mix(.24,.86,gold)*(1.-constellation*.84);
        float width=mix(.009,.019,gold)*(1.-constellation*.62);
        if(location>2. && location<4.) width+=sin((location-2.)*PI*.5)*.016;
        float distance=curve(p,a,b,cc,d,1.);
        paint(c,distance-width,hue,alpha,aa);
        c+=GOLD*.019*gold*(1.-constellation)*exp(-distance*32.);
    }
}

void forest(inout vec3 c,vec2 p,float t,float aa) {
    float grow=ease(50.,59.,t)*(1.-ease(75.,83.,t)); if(grow<.001) return;
    for(int j=0;j<7;j++) {
        float i=float(j),x=-8.3+i*2.80,h=hash(i+3.),bend=(.42+.15*gust(t+i))*grow;
        vec2 a=vec2(x,-2.60),b=a+vec2(-.18,1.70*grow),cc=a+vec2(bend,4.3*grow),d=a+vec2(bend*1.6,(6.6+h)*grow);
        float distance=curve(p,a,b,cc,d,1.),width=mix(.17,.065,sat((p.y+2.6)/6.));
        vec3 bark=mix(vec3(.115,.25,.28),vec3(.18,.32,.33),h);
        paint(c,distance-width,bark,1.,aa); paint(c,distance-width*.70,MIST,.10,aa);
        for(int k=0;k<3;k++) {
            float f=float(k),side=mod(f+i,2.)<.5?-1.:1.;
            vec2 root=bezier(a,b,cc,d,.32+f*.17),end=root+vec2(side*(1.3+f*.15),1.2*grow);
            inkCurve(c,p,root,root+vec2(side*.55,.12),end-vec2(side*.12,.50),end,.027-f*.005,bark,1.,aa);
            for(int l=0;l<3;l++) {
                vec2 at=mix(root,end,.62+float(l)*.16)+vec2(side*.10,.12);
                vec2 q=rotate(side*.7+.1*sin(t+i+f))*(p-at);
                paint(c,ellipse(q,vec2(.20*grow,.064*grow)),mix(bark,TEAL,.50),.85,aa);
            }
        }
    }
}
void vessel(inout vec3 c,vec2 p,float t,float aa) {
    if(t<31. || t>55.) return;
    float open=ease(31.,37.,t),release=ease(49.,55.,t); vec2 q=p-boatCenter(t);
    // Paper surfaces unfold from a narrow ribbon and stretch back into waves.
    q.x/=mix(2.70,1.,open)*(1.+release*4.); q.y/=max(.005,open*(1.-release));
    float a=aa/max(.02,open*(1.-release));
    paint(c,art_boat(q),vec3(.77,.76,.62),1.,a);
    paint(c,art_sail(q),PAPER,1.,a);
    paint(c,art_sailShade(q),vec3(.72,.71,.59),.50,a);
    inkCurve(c,q,vec2(-1.55,.16),vec2(-.72,-.11),vec2(.21,-.22),vec2(1.54,.34),.012,vec3(.40,.46,.43),.85,a);
    inkCurve(c,q,vec2(.19,-.48),vec2(.08,-.22),vec2(-.01,.08),vec2(-.02,.19),.010,vec3(.40,.46,.43),.80,a);
    inkCurve(c,q,vec2(-.08,.21),vec2(-.03,.75),vec2(-.04,1.42),vec2(.02,1.98),.014,GOLD,.85,a);
    inkCurve(c,q,vec2(.02,1.98),vec2(.25,2.05),vec2(.36,1.85+.04*sin(t*2.)),vec2(.60,1.94),.026,CORAL,.95,a);
}
void treeDetails(inout vec3 c,vec2 p,float t,float aa) {
    if(t<76. || t>110.) return;
    float growth=ease(76.,91.,t),release=ease(96.,106.,t);
    vec2 q=p; q.y=-2.42+(q.y+2.42)/max(.008,growth);
    q.x-=.045*sin(t*.8+q.y)*sat((q.y+2.4)/5.);
    float trunk=art_trunk(q);
    paint(c,trunk,vec3(.34,.40,.32),1.-release,aa/max(.1,growth));
    paint(c,abs(trunk)-.009,GOLD,.70*(1.-release),aa);
    for(int j=1;j<18;j++) {
        float i=float(j),side=mod(i,2.)<.5?-1.:1.; vec2 a,b,cc,d; treeControls(i,a,b,cc,d);
        float born=ease(79.+i*.28,83.+i*.28,t);
        for(int k=0;k<2;k++) {
            float f=float(k); vec2 root=bezier(a,b,cc,d,.57+f*.24);
            vec2 end=root+vec2(side*(.18+hash(i+f)*.18),.42+.14*hash(i+8.));
            float u=born*(1.-release);
            inkCurve(c,p,root,mix(root,root+vec2(side*.13,.06),u),mix(root,end-vec2(side*.06,.25),u),mix(root,end,u),.009,GOLD,.72,aa);
        }
    }
    for(int j=0;j<5;j++) {
        float i=float(j),side=mod(i,2.)<.5?-1.:1.,u=ease(77.,82.+i,t)*(1.-release);
        vec2 end=vec2(side*(.85+i*.28),-2.60+.05*sin(i));
        float d=curve(p,vec2(.06,-2.38),vec2(side*.30,-2.50),vec2(side*.64,-2.24),end,u);
        paint(c,d-.009,GOLD,.58,aa);
    }
}
void leafFlight(inout vec3 c,vec2 p,float t,float aa) {
    if(t<81.) return;
    for(int j=0;j<34;j++) {
        float i=float(j),branch=1.+floor(i*.5),f=mod(i,2.),side=mod(branch,2.)<.5?-1.:1.;
        vec2 a,b,cc,d; treeControls(branch,a,b,cc,d);
        vec2 from=bezier(a,b,cc,d,.75+f*.23)+vec2(side*.09,.10+f*.06);
        float birth=ease(82.+branch*.27+f*.35,85.+branch*.25+f*.35,t);
        float start=96.+hash(i+8.)*3.4,u=ease(start,start+10.5,t),morph=ease(start,start+2.4,t);
        vec2 target=starPosition(i+19.),at=mix(from,target,u)+vec2(side*sin(u*PI)*.68,sin(u*PI)*.85);
        float scale=mix(.42,.34,ease(.35,1.,u))*max(.002,birth);
        vec2 q=rotate(mix(side*.43,.12*sin(t+i),morph))*(p-at)/scale;
        float shape=art_leafBirdStar(q,.75+.37*sin(t*4.6+i),morph,ease(start+8.8,start+11.4,t))*scale;
        paint(c,shape,mix(GOLD,PAPER,hash(i+3.)*.55),1.,aa);
        c+=GOLD*.018*birth*exp(-dot(p-at,p-at)*46.);
    }
}
void foreground(inout vec3 c,vec2 p,float t,float aa) {
    for(int j=0;j<2;j++) {
        float side=j==0?-1.:1.;
        vec2 a=vec2(side*8.6,-3.35),b=vec2(side*7.5,-2.70),cc=vec2(side*7.7,-1.20),d=vec2(side*6.6,-.60);
        inkCurve(c,p,a,b,cc,d,.032,vec3(.15,.30,.32),1.,aa);
        for(int k=0;k<7;k++) {
            float f=float(k),direction=mod(f,2.)<.5?-1.:1.; vec2 at=bezier(a,b,cc,d,.17+f*.115);
            vec2 q=rotate(side*.48+direction*.77+.04*sin(t+f))*(p-at);
            paint(c,ellipse(q,vec2(.29,.086)),mix(vec3(.13,.28,.30),TEAL,f/12.),1.,aa);
            inkCurve(c,q,vec2(-.22,0.),vec2(-.07,.02),vec2(.10,.01),vec2(.22,0.),.005,MIST,.24,aa);
        }
    }
}
void particles(inout vec3 c,vec2 p,float t,float aa) {
    float storm=ease(53.,58.,t)*(1.-ease(73.,78.,t));
    for(int j=0;j<17;j++) {
        float i=float(j),h=hash(i+6.),u=fract(t*(.017+storm*.06)+h);
        vec2 at=vec2(-9.+u*18.,-1.9+hash(i+4.)*5.+.18*sin(u*TAU+i));
        paint(c,ellipse(rotate(.3+storm*.50)*(p-at),vec2(.014+storm*.025,.0045)),mix(MIST,GOLD,h),.35,aa);
    }
}

float sdfSample(vec2 q,vec4 tile) {
    q.y=1.-q.y;
    vec2 pix=clamp(tile.xy+q*tile.zw-.5,tile.xy,tile.xy+tile.zw-1.);
    vec2 b=floor(pix),f=fract(pix);
    float a=texture2D(TEXTURE_2,(b+vec2(.5,.5))/4096.).r;
    float b0=texture2D(TEXTURE_2,(b+vec2(1.5,.5))/4096.).r;
    float c0=texture2D(TEXTURE_2,(b+vec2(.5,1.5))/4096.).r;
    float d=texture2D(TEXTURE_2,(b+vec2(1.5,1.5))/4096.).r;
    return (mix(mix(a,b0,f.x),mix(c0,d,f.x),f.y)-.5)*48.;
}
void letter(inout vec3 c,vec2 p,vec2 at,vec2 size,vec4 tile,vec3 hue,float opacity,float aa) {
    vec2 q=(p-at)/size+.5; if(min(q.x,q.y)<.003 || max(q.x,q.y)>.997) return;
    float d=sdfSample(q,tile),edge=clamp(.5*fwidth(d),.55,8.),ink=smoothstep(-edge,edge,d);
    c=mix(c,c*.33,smoothstep(-edge-1.5,edge-1.5,d)*opacity*.55); c=mix(c,hue,ink*opacity);
}
// Closed contour correspondence, stored in the existing atlas' lower half.
// All loops are fixed-budget; each glyph rejects its screen box before reads.
mat2 vmRot(float angle) {
    return mat2(cos(angle),-sin(angle),sin(angle),cos(angle));
}
void vmPaint(inout vec3 c,vec3 hue,float coverage) {
    c = mix(c, hue, coverage);
}
float vmSdfCoverage(vec2 q,vec4 tile) {
    float distance=sdfSample(q,tile);
    float edge=clamp(0.5*fwidth(distance),0.55,12.0);
    return smoothstep(-edge,edge,distance);
}
void vectorStaticGlyph(inout vec3 c,vec2 p,vec2 a,vec2 sa,vec4 ta,
                       vec2 b,vec2 sb,vec4 tb,float u,float arc,
                       vec3 hue,float opacity,float aa) {
    float lift=sin(3.14159265359*u);
    vec2 center=mix(a,b,u)+vec2(arc*0.21,arc)*lift;
    vec2 size=max(mix(sa,sb,u),vec2(0.00001));
    vec2 local=vmRot(lift*arc*0.16)*(p-center);
    vec2 q=local/size+0.5;
    if(min(q.x,q.y)<0.005 || max(q.x,q.y)>0.995 || opacity<0.001) return;
    vmPaint(c,hue,opacity*vmSdfCoverage(q,ta));
}
vec2 vmReadPoint(float index) {
    vec2 pixel=vec2(mod(index,4096.0),floor(index/4096.0));
    vec4 bytes=floor(texture2D(TEXTURE_2,(pixel+0.5)/4096.0)*255.0+0.5);
    return vec2(bytes.r*256.0+bytes.g,bytes.b*256.0+bytes.a)/65535.0;
}
void vectorGlyph(inout vec3 c,vec2 p,vec2 a,vec2 sa,vec4 ta,
                 vec2 b,vec2 sb,vec4 tb,float u,float arc,
                 vec3 hue,float opacity,float aa,vec2 data,vec2 present) {
    if(opacity<0.001) return;
    if(u<=0.0) {
        if(present.x>0.5) vectorStaticGlyph(c,p,a,sa,ta,a,sa,ta,0.0,0.0,hue,opacity,aa);
        return;
    }
    if(u>=1.0) {
        if(present.y>0.5) vectorStaticGlyph(c,p,b,sb,tb,b,sb,tb,0.0,0.0,hue,opacity,aa);
        return;
    }
    float lift=sin(3.14159265359*u);
    vec2 center=mix(a,b,u)+vec2(arc*0.21,arc)*lift;
    vec2 size=max(mix(sa,sb,u),vec2(0.00001));
    vec2 local=vmRot(lift*arc*0.16)*(p-center);
    vec2 q=local/size+0.5;
    if(min(q.x,q.y)<0.005 || max(q.x,q.y)>0.995) return;
    float distanceSquared=1e8;
    float winding=0.0;
    vec2 previous=vec2(0.0);
    bool connected=false;
    for(int i=0;i<256;i++) {
        if(float(i)>=data.y) break;
        float address=data.x+float(i)*2.0;
        vec2 first=vmReadPoint(address);
        if(first.x>0.99) { connected=false; continue; }
        vec2 second=vmReadPoint(address+1.0);
        vec2 current=(mix(first,second,u)-0.5)*size;
        if(connected) {
            vec2 edge=current-previous;
            vec2 relative=local-previous;
            float along=clamp(dot(relative,edge)/max(dot(edge,edge),1e-20),0.0,1.0);
            vec2 delta=relative-along*edge;
            distanceSquared=min(distanceSquared,dot(delta,delta));
            float side=edge.x*relative.y-edge.y*relative.x;
            if(previous.y<=local.y && current.y>local.y && side>0.0) winding+=1.0;
            if(previous.y>local.y && current.y<=local.y && side<0.0) winding-=1.0;
        }
        previous=current;
        connected=true;
    }
    float signedDistance=sqrt(distanceSquared)*(abs(winding)>0.5?1.0:-1.0);
    float edge=max(aa*0.55,0.00001);
    float coverage=smoothstep(-edge,edge,signedDistance);
    // Only endpoint AA is reconciled; unrelated glyph distance fields never mix.
    if(u<0.025 && present.x>0.5)
        coverage=mix(vmSdfCoverage(q,ta),coverage,smoothstep(0.0,0.025,u));
    if(u>0.975 && present.y>0.5)
        coverage=mix(coverage,vmSdfCoverage(q,tb),smoothstep(0.975,1.0,u));
    vmPaint(c,hue,coverage*opacity);
}

void typography(inout vec3 c,vec2 p,float t,float aa) {
if(t>=3.400 && t<18.500) {
vectorGlyph(c,p,vec2(-1.780180,-3.200450),vec2(0.365165,0.334354),vec4(0.000000,0.000000,192.000000,192.000000),vec2(-1.780180,-3.165450),vec2(0.365165,0.334354),vec4(0.000000,0.000000,192.000000,192.000000),smoothstep(3.4000,4.1200,t),0.000000,PAPER,1.0,aa,vec2(8388608.000000,256.000000),vec2(0.000000,1.000000));
vectorGlyph(c,p,vec2(-1.506306,-3.199595),vec2(0.365165,0.336637),vec4(192.000000,0.000000,192.000000,192.000000),vec2(-1.506306,-3.164595),vec2(0.365165,0.336637),vec4(192.000000,0.000000,192.000000,192.000000),smoothstep(3.4420,4.1620,t),0.000000,PAPER,1.0,aa,vec2(8389120.000000,218.000000),vec2(0.000000,1.000000));
vectorGlyph(c,p,vec2(-1.232432,-3.205586),vec2(0.365165,0.322943),vec4(384.000000,0.000000,192.000000,192.000000),vec2(-1.232432,-3.170586),vec2(0.365165,0.322943),vec4(384.000000,0.000000,192.000000,192.000000),smoothstep(3.4840,4.2040,t),0.000000,PAPER,1.0,aa,vec2(8389556.000000,256.000000),vec2(0.000000,1.000000));
vectorGlyph(c,p,vec2(-0.958559,-3.199167),vec2(0.365165,0.335495),vec4(576.000000,0.000000,192.000000,192.000000),vec2(-0.958559,-3.164167),vec2(0.365165,0.335495),vec4(576.000000,0.000000,192.000000,192.000000),smoothstep(3.5260,4.2460,t),0.000000,PAPER,1.0,aa,vec2(8390068.000000,256.000000),vec2(0.000000,1.000000));
vectorGlyph(c,p,vec2(-0.684685,-3.314279),vec2(0.365165,0.115255),vec4(768.000000,0.000000,192.000000,192.000000),vec2(-0.684685,-3.279279),vec2(0.365165,0.115255),vec4(768.000000,0.000000,192.000000,192.000000),smoothstep(3.5680,4.2880,t),0.000000,PAPER,1.0,aa,vec2(8390580.000000,82.000000),vec2(0.000000,1.000000));
vectorGlyph(c,p,vec2(-0.410811,-3.198739),vec2(0.365165,0.318378),vec4(960.000000,0.000000,192.000000,192.000000),vec2(-0.410811,-3.163739),vec2(0.365165,0.318378),vec4(960.000000,0.000000,192.000000,192.000000),smoothstep(3.6100,4.3300,t),0.000000,PAPER,1.0,aa,vec2(8390744.000000,256.000000),vec2(0.000000,1.000000));

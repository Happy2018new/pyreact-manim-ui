float art_leafBirdStar(vec2 p,float wing,float morph,float constellation) {
if(max(abs(p.x),abs(p.y))>.62) return max(abs(p.x),abs(p.y))-.60;
float d=100.; float winding=1.; vec2 a; vec2 b;
a=mix(mix(vec2(-0.30050,-0.01096),vec2(-0.39932,0.20922)*vec2(1.,wing),morph),vec2(-0.08080,-0.00412),constellation);
b=mix(mix(vec2(-0.32000,0.00000),vec2(-0.43661,0.25205)*vec2(1.,wing),morph),vec2(-0.09040,-0.00206),constellation); contourEdge(p,a,b,d,winding); a=b;

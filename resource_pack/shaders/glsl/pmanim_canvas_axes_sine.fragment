                            } else {
                                return vec3(152.0, 153.0, clamp((t - 5.066666667) / 0.03333333333, 0.0, 1.0));
                            }
                        }
                    }
                }
            } else {
                if (t < 5.466666667) {
                    if (t < 5.3) {
                        if (t < 5.2) {
                            if (t < 5.166666667) {
                                if (t < 5.133333333) {

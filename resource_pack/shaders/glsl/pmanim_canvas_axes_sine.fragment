}


// Accumulate all paths and strokes in premultiplied form. The material uses
// SourceAlpha blending, so convert to straight alpha only at the final output.
void canvasOver(inout vec3 premultiplied, inout float alpha, vec3 rgb, float coverage) {
    float a = clamp(coverage, 0.0, 1.0);
    premultiplied = rgb * a + premultiplied * (1.0 - a);
    alpha = a + alpha * (1.0 - a);
}

void main() {
    vec2 screenUV = uv;
    if (EXTRA_ACTOR_UNIFORM2.x > 0.5) screenUV.y = 1.0 - screenUV.y;
    float canvasHeight = EXTRA_ACTOR_UNIFORM2.z > 0.0 ? EXTRA_ACTOR_UNIFORM2.z : 1.0;
    float canvasTop = EXTRA_ACTOR_UNIFORM2.z > 0.0 ? EXTRA_ACTOR_UNIFORM2.y : 0.0;
    screenUV.y = (screenUV.y - canvasTop) / canvasHeight;
    float aspect = max(EXTRA_ACTOR_UNIFORM1.y, 0.001);
    float viewportHeight = max(EXTRA_ACTOR_UNIFORM1.z, 1.0);
    // Contain the authored canvas without stretching glyphs.
    float visibleHeight = max(8.0, 14.222222 / aspect);
    vec2 p = (screenUV - vec2(0.5)) * vec2(visibleHeight * aspect, -visibleHeight);
    float aa = visibleHeight / viewportHeight * 0.75;
    vec3 frames = selectFrames(EXTRA_ACTOR_UNIFORM1.x);
    vec3 canvasPremultiplied = vec3(0.0);
    float canvasAlpha = 0.0;
    if (screenUV.y >= 0.0 && screenUV.y <= 1.0) {
    // Path 0; conservative bounds cover every reference keyframe.
    {
        float styleOffset = 388.0;
        float width = readScalar(styleOffset + 8.0) * STROKE_SCALE;
        float margin = width * 0.5 + aa * 2.0;
        if (all(greaterThanEqual(p, vec2(-5.0, -0.1) - vec2(margin))) &&
            all(lessThanEqual(p, vec2(5.0, 0.1) + vec2(margin)))) {
            float winding = 0.0;
            float distanceToPath = 1.0e20;
            float nearestSide = 1.0;
            {
                vec2 a = staticPoint(6.0);
                for (int i = 0; i < 7; ++i) {
                    vec2 b = staticPoint(0.0 + float(i));
                    edge(p, a, b, winding, distanceToPath, nearestSide);
                    a = b;
                }
            }
            // Antialias the winding transition, not every internal contour edge.
            float edgeCoverage = 1.0 - smoothstep(-aa, aa, distanceToPath);
            float fillCoverage = clamp(abs(winding - nearestSide * edgeCoverage), 0.0, 1.0);
            vec4 fill = staticColor(styleOffset);
            canvasOver(canvasPremultiplied, canvasAlpha, fill.rgb, fill.a * fillCoverage);
            if (width > 0.0) {
                float strokeCoverage = 1.0 - smoothstep(width * 0.5 - aa, width * 0.5 + aa, distanceToPath);
                vec4 stroke = staticColor(styleOffset + 4.0);
                canvasOver(canvasPremultiplied, canvasAlpha, stroke.rgb, stroke.a * strokeCoverage);
            }
        }
    }
    // Path 1; conservative bounds cover every reference keyframe.
    {
        float styleOffset = 397.0;
        float width = readScalar(styleOffset + 8.0) * STROKE_SCALE;
        float margin = width * 0.5 + aa * 2.0;
        if (all(greaterThanEqual(p, vec2(-0.1, -2.0) - vec2(margin))) &&
            all(lessThanEqual(p, vec2(0.1, 2.0) + vec2(margin)))) {
            float winding = 0.0;
            float distanceToPath = 1.0e20;
            float nearestSide = 1.0;
            {
                vec2 a = staticPoint(13.0);
                for (int i = 0; i < 7; ++i) {
                    vec2 b = staticPoint(7.0 + float(i));
                    edge(p, a, b, winding, distanceToPath, nearestSide);
                    a = b;
                }
            }
            // Antialias the winding transition, not every internal contour edge.
            float edgeCoverage = 1.0 - smoothstep(-aa, aa, distanceToPath);
            float fillCoverage = clamp(abs(winding - nearestSide * edgeCoverage), 0.0, 1.0);
            vec4 fill = staticColor(styleOffset);
            canvasOver(canvasPremultiplied, canvasAlpha, fill.rgb, fill.a * fillCoverage);
            if (width > 0.0) {
                float strokeCoverage = 1.0 - smoothstep(width * 0.5 - aa, width * 0.5 + aa, distanceToPath);
                vec4 stroke = staticColor(styleOffset + 4.0);
                canvasOver(canvasPremultiplied, canvasAlpha, stroke.rgb, stroke.a * strokeCoverage);
            }
        }
    }
    // Path 2; conservative bounds cover every reference keyframe.
    {
        float styleOffset = 406.0;
        float width = readScalar(styleOffset + 8.0) * STROKE_SCALE;
        float margin = width * 0.5 + aa * 2.0;
        if (all(greaterThanEqual(p, vec2(-4.506425671, -1.024488399) - vec2(margin))) &&
            all(lessThanEqual(p, vec2(4.506425671, 1.024488399) + vec2(margin)))) {
            float winding = 0.0;
            float distanceToPath = 1.0e20;
            float nearestSide = 1.0;
            {
                vec2 a = samplePoint(173.0, frames);
                for (int i = 0; i < 160; ++i) {
                    vec2 b = samplePoint(14.0 + float(i), frames);
                    edge(p, a, b, winding, distanceToPath, nearestSide);
                    a = b;
                }
            }
            // Antialias the winding transition, not every internal contour edge.
            float edgeCoverage = 1.0 - smoothstep(-aa, aa, distanceToPath);
            float fillCoverage = clamp(abs(winding - nearestSide * edgeCoverage), 0.0, 1.0);
            vec4 fill = staticColor(styleOffset);
            canvasOver(canvasPremultiplied, canvasAlpha, fill.rgb, fill.a * fillCoverage);
            if (width > 0.0) {
                float strokeCoverage = 1.0 - smoothstep(width * 0.5 - aa, width * 0.5 + aa, distanceToPath);
                vec4 stroke = staticColor(styleOffset + 4.0);
                canvasOver(canvasPremultiplied, canvasAlpha, stroke.rgb, stroke.a * strokeCoverage);
            }
        }
    }
    // Path 3; conservative bounds cover every reference keyframe.
    {
        float styleOffset = 415.0;
        float width = readScalar(styleOffset + 8.0) * STROKE_SCALE;
        float margin = width * 0.5 + aa * 2.0;
        if (all(greaterThanEqual(p, vec2(-4.59, -1.089573603) - vec2(margin))) &&
            all(lessThanEqual(p, vec2(4.59, 1.089573603) + vec2(margin)))) {
            float winding = 0.0;
            float distanceToPath = 1.0e20;
            float nearestSide = 1.0;
            {
                vec2 a = samplePoint(193.0, frames);
                for (int i = 0; i < 20; ++i) {
                    vec2 b = samplePoint(174.0 + float(i), frames);
                    edge(p, a, b, winding, distanceToPath, nearestSide);
                    a = b;
                }
            }
            // Antialias the winding transition, not every internal contour edge.
            float edgeCoverage = 1.0 - smoothstep(-aa, aa, distanceToPath);
            float fillCoverage = clamp(abs(winding - nearestSide * edgeCoverage), 0.0, 1.0);
            vec4 fill = sampleColor(styleOffset, frames);
            canvasOver(canvasPremultiplied, canvasAlpha, fill.rgb, fill.a * fillCoverage);
            if (width > 0.0) {
                float strokeCoverage = 1.0 - smoothstep(width * 0.5 - aa, width * 0.5 + aa, distanceToPath);
                vec4 stroke = staticColor(styleOffset + 4.0);
                canvasOver(canvasPremultiplied, canvasAlpha, stroke.rgb, stroke.a * strokeCoverage);
            }
        }
    }
    }
    vec3 straightColor = canvasAlpha > 0.0 ? canvasPremultiplied / canvasAlpha : vec3(0.0);
    gl_FragColor = vec4(straightColor, canvasAlpha * clamp(EXTRA_ACTOR_UNIFORM1.w, 0.0, 1.0));
}

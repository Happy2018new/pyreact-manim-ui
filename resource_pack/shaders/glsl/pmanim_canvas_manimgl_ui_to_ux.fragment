vec2 samplePoint(float index, vec3 frames) {
    vec2 normalized = vec2(sampleScalar(index * 2.0, frames), sampleScalar(index * 2.0 + 1.0, frames));
    return POSITION_MIN + normalized * POSITION_SPAN;
}


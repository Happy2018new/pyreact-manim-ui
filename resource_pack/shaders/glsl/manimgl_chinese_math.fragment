float readScalar(float index) {
    vec2 tc = (vec2(mod(index, ATLAS_SIZE.x), floor(index / ATLAS_SIZE.x)) + vec2(0.5)) / ATLAS_SIZE;
    vec2 bytes = floor(texture2D(TEXTURE_2, tc).rg * 255.0 + vec2(0.5));

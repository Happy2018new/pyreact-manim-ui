            fanEdge(px, py, a, base, winding);
        }
        if (sampleScalar(3884.0, frames) > 0.0) {
            vec2 a = samplePoint(1649.0, frames);
            fanEdge(px, py, base, a, winding);
            for (int i = 1; i < 5; ++i) {
                vec2 b = samplePoint(1649.0 + float(i), frames);
                fanEdge(px, py, a, b, winding);
                distanceToCurve = min(distanceToCurve, fanSegmentDistance(px, py, a, b));
                a = b;
            }
            fanEdge(px, py, a, base, winding);
        }
        if (sampleScalar(3885.0, frames) > 0.0) {

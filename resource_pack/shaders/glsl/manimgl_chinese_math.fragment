        if (sampleScalar(3892.0, frames) > 0.0) {
            vec2 a = samplePoint(1687.0, frames);
            fanEdge(px, py, base, a, winding);
            for (int i = 1; i < 6; ++i) {
                vec2 b = samplePoint(1687.0 + float(i), frames);
                fanEdge(px, py, a, b, winding);
                distanceToCurve = min(distanceToCurve, fanSegmentDistance(px, py, a, b));
                a = b;

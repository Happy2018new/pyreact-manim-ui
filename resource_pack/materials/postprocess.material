  "pmanim_manimgl_o_to_b": {
    "vertexShader": "shaders/uv_fullscreen.vertex",
    "fragmentShader": "shaders/manimgl_o_to_b.fragment",
    "vertexFields": [
      {
        "field": "Position"
      },
      {
        "field": "UV0"
      }
    ],
    "samplerStates": [
      {
        "samplerIndex": 0,
        "textureWrap": "Clamp",
        "textureFilter": "Point"
      },
      {
        "samplerIndex": 1,
        "textureWrap": "Clamp",
        "textureFilter": "Point"
      },
      {
        "samplerIndex": 2,
        "textureWrap": "Clamp",
        "textureFilter": "Point"
      }
    ],
    "states": [
      "DisableDepthTest"
    ],
    "msaaSupport": "Both"
  },

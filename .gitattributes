* text=auto
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.glsl text eol=lf
*.fragment text eol=lf
*.vertex text eol=lf
*.material text eol=lf
*.png binary
*.webp binary
*.ttf binary
*.otf binary
# Keep the upstream license copy byte-for-byte, including its original spaces.
**/LICENSE_DEJAVU -text -whitespace

# Preserve the exact evidence bytes used by archived SHA-256 manifests.
docs/evidence/geometry-atlas/streaming/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

// __multiversion__
precision highp float;
#include "fragmentVersionCentroidUV.h"

uniform sampler2D TEXTURE_1;
uniform sampler2D TEXTURE_3;
uniform vec4 EXTRA_VECTOR1; // page count, page start, displayed rows, word shift
uniform vec4 EXTRA_VECTOR2; // left/top/width/height, top-left screen origin
uniform vec4 EXTRA_VECTOR3; // page columns, page rows, reserved, reserved

void main() {
    vec2 point = (vec2(uv.x, 1.0 - uv.y) - EXTRA_VECTOR2.xy) / EXTRA_VECTOR2.zw;
    if (point.x < 0.0 || point.x >= 1.0 || point.y < 0.0 || point.y >= 1.0) {
        gl_FragColor = vec4(texture2D(TEXTURE_1, uv).rgb, 1.0);
        return;
    }
    float page = floor(EXTRA_VECTOR1.y) + floor(point.y * EXTRA_VECTOR1.z);
    if (page < 0.0 || page >= EXTRA_VECTOR1.x) {
        // Keep a fixed window height on the final partial window.
        gl_FragColor = vec4(0.0, 0.0, 0.0, 1.0);
        return;
    }
    float cell = floor(point.x * 24.0);
    float word = mod(floor(cell / 3.0) + floor(EXTRA_VECTOR1.w), 8.0);
    float component = mod(cell, 3.0);
    float pageColumn = mod(page, EXTRA_VECTOR3.x);
    float pageRow = floor(page / EXTRA_VECTOR3.x);
    vec2 location = vec2((pageColumn * 8.0 + word + 0.5) / (EXTRA_VECTOR3.x * 8.0),
                         (pageRow + 0.5) / EXTRA_VECTOR3.y);
    // Payload exists only in the explicitly selected producer texture.
    vec3 bytes = texture2D(TEXTURE_3, location).rgb;
    float value = bytes.r;
    if (component >= 1.5) value = bytes.b;
    else if (component >= 0.5) value = bytes.g;
    gl_FragColor = vec4(value, value, value, 1.0);
}

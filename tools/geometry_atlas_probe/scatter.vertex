// __multiversion__
precision highp float;
#include "vertexVersionCentroid.h"
#include "uniformWorldConstants.h"

attribute POS4 POSITION;
uniform highp vec4 EXTRA_ACTOR_UNIFORM1; // stride, yOffset, count, atlas columns
uniform highp vec4 EXTRA_ACTOR_UNIFORM2; // left px, top px, cell px, physical width
uniform highp vec4 EXTRA_ACTOR_UNIFORM3; // physical height, source center XYZ
uniform highp vec4 EXTRA_ACTOR_UNIFORM4; // visible, bank selector (0=fresh,1/2=banks,3=none), reserved, reserved
uniform highp float COMMON_BLOCK_GEO_FLOAT1_1; // geometry transparency tag: .25=bank0, .75=bank1
varying highp float geometryByte;

void main() {
    float stride = EXTRA_ACTOR_UNIFORM1.x;
    float count = EXTRA_ACTOR_UNIFORM1.z;
    float columns = EXTRA_ACTOR_UNIFORM1.w;
    vec3 source = POSITION.xyz + EXTRA_ACTOR_UNIFORM3.yzw;
    // Atlas JSON templates use [0,.5] X/Z planes. Capture-calibrated center
    // (1,.5,.5) corrects the native X offset; the inferred input endpoint
    // sets are X={i-1,i-.5}, Z={i-.5,i}. These half steps survive binary16
    // quantization over this domain. Neither the input vertex format nor
    // the JSON-to-native transform was directly captured.
    vec2 cell = floor(source.xz + vec2(0.25));
    float record = cell.x * stride + cell.y;
    vec2 corner = (source.xz - cell) * 2.0;
    float value = 16.0 * floor(source.y) + floor(16.0 * fract(source.y));
    geometryByte = value / 255.0;
    float bank = COMMON_BLOCK_GEO_FLOAT1_1 < 0.5 ? 1.0 : 2.0;
    if (EXTRA_ACTOR_UNIFORM4.x < 0.5 || stride < 1.0 || columns < 1.0 ||
        (EXTRA_ACTOR_UNIFORM4.y > 0.5 && abs(bank - EXTRA_ACTOR_UNIFORM4.y) > 0.25) ||
        record < 0.0 || record >= count || EXTRA_ACTOR_UNIFORM2.z < 1.0 ||
        EXTRA_ACTOR_UNIFORM2.w < 1.0 || EXTRA_ACTOR_UNIFORM3.x < 1.0) {
        gl_Position = vec4(2.0, 2.0, 0.0, 1.0);
        return;
    }
    vec2 grid = vec2(mod(record, columns), floor(record / columns));
    vec2 pixels = EXTRA_ACTOR_UNIFORM2.xy +
                  (grid + corner) * EXTRA_ACTOR_UNIFORM2.z;
    vec2 size = vec2(EXTRA_ACTOR_UNIFORM2.w, EXTRA_ACTOR_UNIFORM3.x);
    vec2 uv = pixels / size;
    gl_Position = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.0, 1.0);
}

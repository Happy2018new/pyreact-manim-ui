// __multiversion__
precision highp float;
#include "fragmentVersionCentroidUV.h"
uniform sampler2D TEXTURE_3; // encoded combined target
uniform sampler2D TEXTURE_4; // independently decoded target
uniform sampler2D TEXTURE_5; // live scene copy; never assume disabled producers retain RTs
uniform vec4 EXTRA_VECTOR1; // k, base alpha byte, inspect mode, start
uniform vec4 EXTRA_VECTOR2; // source ROI left,top,width,height
uniform vec4 EXTRA_VECTOR3; // physical width,height,flip source Y,count
uniform vec4 EXTRA_VECTOR4; // engine ScreenInfo: width,height,pixelWidth,pixelHeight

// Diagnostic mode 23 uses the probe's declared 64 KiB, salt-29 payload.
// It reads RGB and alpha from one source sample in the same render turn.
float oracleByte(float index) {
    if (index >= 65536.0) return 0.0;
    return mod(mod(index,256.0)*73.0+mod(floor(index/251.0),256.0)*19.0+29.0,256.0);
}

float oracleSymbol(float index) {
    float result=0.0;
    float width=3.0*EXTRA_VECTOR1.x;
    for (int bit=0;bit<6;++bit) {
        if (float(bit)<width) {
            float address=index*width+float(bit);
            float value=oracleByte(floor(address/8.0));
            result+=mod(floor(value/exp2(mod(address,8.0))),2.0)*exp2(float(bit));
        }
    }
    return result;
}

void main() {
    float nativeMode = step(9.5, EXTRA_VECTOR1.z);
    float mode = EXTRA_VECTOR1.z - 10.0 * nativeMode;
    vec2 physical = vec2(uv.x, 1.0 - uv.y) * EXTRA_VECTOR3.xy;
    vec2 p = vec2(uv.x, 1.0 - uv.y);
    p.y = (p.y * EXTRA_VECTOR3.y - 128.0) / 936.0;
    float rows = ceil(EXTRA_VECTOR3.w / 64.0);
    if (p.x < 0.0 || p.x >= 1.0 || p.y < 0.0 || p.y >= 1.0 || rows < 1.0) {
        gl_FragColor = vec4(0.0,0.0,0.0,1.0); return;
    }
    float ordinal = nativeMode > 0.5
        ? floor(physical.y-128.0)*EXTRA_VECTOR3.x+floor(physical.x)
        : floor(p.y * rows) * 64.0 + floor(p.x * 64.0);
    if (ordinal >= EXTRA_VECTOR3.w) { gl_FragColor=vec4(0.0,0.0,0.0,1.0); return; }
    float index = EXTRA_VECTOR1.w + ordinal;
    vec2 pixel = EXTRA_VECTOR2.xy + vec2(mod(index,EXTRA_VECTOR2.z),floor(index/EXTRA_VECTOR2.z));
    vec2 loc = (pixel+0.5)/EXTRA_VECTOR3.xy;
    if (EXTRA_VECTOR3.z > 0.5) loc.y=1.0-loc.y;
    vec4 raw=texture2D(TEXTURE_5,loc);
    vec4 combined=texture2D(TEXTURE_3,loc);
    vec4 decoded=texture2D(TEXTURE_4,loc);
    vec3 result;
    if (mode < 0.5) result=vec3(raw.a);
    else if (mode < 1.5) result=raw.rgb;
    else if (mode < 2.5) result=decoded.rgb;
    else if (mode < 3.5) result=vec3(decoded.a);
    else if (mode < 4.5) result=vec3(combined.a);
    else if (mode < 5.5) {
        float code=floor(clamp(raw.a,0.0,1.0)*16777215.0+0.5);
        result=vec3(mod(code,256.0),mod(floor(code/256.0),256.0),floor(code/65536.0))/255.0;
    } else if (mode < 6.5) result=abs(decoded.rgb-raw.rgb);
    else if (mode < 7.5) result=vec3(mod(index,256.0)/255.0);
    else if (mode < 8.5) {
        float a=raw.a*255.0;
        float residual=abs(a-floor(a+0.5));
        result=vec3(floor(a+0.5)/255.0,min(residual*2.0,1.0),step(0.0001,residual));
    } else if (mode < 9.5) result=combined.rgb;
    else if (mode < 10.5) result=vec3(abs(decoded.a-raw.a));
    else if (mode < 11.5) {
        vec2 pixel=floor(gl_FragCoord.xy);
        result=vec3(mod(pixel.x,256.0),mod(pixel.y,256.0),
                    floor(pixel.x/256.0)+4.0*floor(pixel.y/256.0))/255.0;
    } else if (mode < 12.5) {
        float component=mod(ordinal,4.0);
        float value=EXTRA_VECTOR4.x;
        if (component > 0.5) value=EXTRA_VECTOR4.y;
        if (component > 1.5) value=EXTRA_VECTOR4.z*16777216.0;
        if (component > 2.5) value=EXTRA_VECTOR4.w*16777216.0;
        float code=floor(value+0.5);
        result=vec3(mod(code,256.0),mod(floor(code/256.0),256.0),floor(code/65536.0))/255.0;
    } else {
        float symbols=exp2(EXTRA_VECTOR1.x);
        vec3 digits=floor(floor(raw.rgb*255.0+0.5)/(256.0/symbols));
        float observed=dot(digits,vec3(1.0,symbols,symbols*symbols));
        float alpha=raw.a*255.0;
        result=vec3(step(0.5,abs(observed-oracleSymbol(index))),
                    floor(alpha+0.5)/255.0,step(0.0001,abs(alpha-floor(alpha+0.5))));
    }
    gl_FragColor=vec4(result,1.0);
}

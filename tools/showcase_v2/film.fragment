// __multiversion__
// METAMORPHOSIS. Authored 120-second score, with per-glyph SDF transport.
precision highp float;
#include "fragmentVersionCentroidUV.h"
uniform sampler2D TEXTURE_0;
uniform sampler2D TEXTURE_2;
uniform vec4 EXTRA_VECTOR1;
uniform vec4 EXTRA_VECTOR2;
const float PI=3.14159265359;
const float TAU=6.28318530718;
const vec3 CYAN=vec3(0.12,0.86,1.0);
const vec3 GOLD=vec3(1.0,0.69,0.24);
const vec3 PINK=vec3(0.97,0.25,0.58);
const vec3 WHITE=vec3(0.94,0.97,1.0);
mat2 rot(float a) { return mat2(cos(a),-sin(a),sin(a),cos(a)); }
float hash1(float n) { return fract(sin(n*127.1+311.7)*43758.5453); }
float gate(float t,float a,float b) {
    return smoothstep(a,a+0.7,t)*(1.0-smoothstep(b-0.7,b,t));
}
float lineDistance(vec2 p,vec2 a,vec2 b) {
    vec2 v=b-a; return length(p-a-v*clamp(dot(p-a,v)/max(dot(v,v),0.000001),0.0,1.0));
}
vec3 glow(float d,float width,vec3 hue,float power,float aa) {
    return hue*power*((1.0-smoothstep(width,width+aa,d))+0.12*exp(-d*24.0));
}
float sdfSample(vec2 q,vec4 tile) {
    q.y=1.0-q.y;
    // q addresses pixel edges; bilinear reads address pixel centers.
    vec2 pix=clamp(tile.xy+q*tile.zw-0.5,tile.xy,tile.xy+tile.zw-1.0);
    vec2 b=floor(pix),f=fract(pix);
    float d00=texture2D(TEXTURE_2,(b+vec2(0.5,0.5))/4096.0).r;
    float d10=texture2D(TEXTURE_2,(b+vec2(1.5,0.5))/4096.0).r;
    float d01=texture2D(TEXTURE_2,(b+vec2(0.5,1.5))/4096.0).r;
    float d11=texture2D(TEXTURE_2,(b+vec2(1.5,1.5))/4096.0).r;
    return (mix(mix(d00,d10,f.x),mix(d01,d11,f.x),f.y)-0.5)*48.0;
}
void glyph(inout vec3 c,vec2 p,vec2 a,vec2 sa,vec4 ta,
           vec2 b,vec2 sb,vec4 tb,float u,float arc,vec3 hue,float opacity,float aa) {
    float lift=sin(PI*u);
    vec2 center=mix(a,b,u)+vec2(arc*0.21,arc)*lift;
    vec2 size=max(mix(sa,sb,u),vec2(0.002));
    vec2 v=rot(lift*arc*0.16)*(p-center);
    vec2 q=v/size+0.5;
    if(min(q.x,q.y)<0.005 || max(q.x,q.y)>0.995 || opacity<0.001) return;
    float da=sdfSample(q,ta), db=sdfSample(q,tb);
    // Only different shapes receive morph styling. Matching-symbol transport
    // retains its solid glyph, including through the middle of the movement.
    float shapeLift=lift*step(0.5,length(ta.xy-tb.xy));
    // A subpixel expansion in atlas space softens stroke erosion while the
    // two distance fields merge. Both endpoint contours remain unchanged.
    float d=mix(da,db,u)+0.6*shapeLift;
    // Each SDF glyph is stretched independently in x/y. Screen derivatives
    // keep a fraction rule's vertical AA from blurring its horizontal ends.
    // The cap stays inside the atlas' +/-24 distance range during tiny births.
    float edge=clamp(0.5*fwidth(d),0.55,12.0);
    float fill=smoothstep(-edge,edge,d);
    float rim=1.0-smoothstep(edge,edge+0.9,abs(d));
    float accent=rim*(1.0-fill)*0.08*shapeLift;
    vec3 color=mix(hue,mix(CYAN,PINK,0.5+arc*0.4),shapeLift*0.38);
    c+=color*opacity*(fill+accent);
    c+=color*opacity*exp(-abs(d)*0.42)*shapeLift*0.04;
}
// __GEOMETRY__
// __TYPE_FUNCTIONS__

vec3 atmosphere(vec2 p,float t,float aa) {
    vec3 c=vec3(0.012,0.019,0.04);
    c+=CYAN*0.025*exp(-dot(p-vec2(-3.0,1.0),p-vec2(-3.0,1.0))*0.075);
    c+=PINK*0.019*exp(-dot(p-vec2(4.0,-1.0),p-vec2(4.0,-1.0))*0.09);
    float kinetic=gate(t,0.0,12.0)*0.3+gate(t,12.0,28.0)*0.5+gate(t,102.0,114.0)*0.9;
    if(kinetic>0.001) {
        for(int j=0;j<7;j++) {
            float i=float(j);
            float wave=sin(p.x*0.42+t*0.38+i*0.57)*(0.35+i*0.08);
            float band=3.25+wave+i*0.11;
            float d=abs(abs(p.y)-band);
            c+=glow(d,0.004,mix(CYAN,PINK,i/7.0),kinetic*0.12,aa);
        }
    }
    float energy=0.3+0.6*gate(t,0.0,12.0)+0.6*gate(t,102.0,114.0);
    for(int j=0;j<48;j++) {
        float i=float(j), h=hash1(i+9.0);
        vec2 v=vec2(hash1(i*7.0)*16.0-8.0,hash1(i*13.0)*8.5-4.25);
        v+=vec2(sin(t*0.06+i),cos(t*0.05+i*2.0))*0.08;
        float d=length(p-v);
        c+=mix(CYAN,PINK,h)*energy*(0.12+0.06*sin(t*0.7+i))*(1.0-smoothstep(0.004,0.004+aa,d));
    }
    return c;
}
vec3 introStage(vec2 p,float t,float aa) {
    vec3 c=vec3(0.0);
    float enter=smoothstep(0.0,1.8,t);
    vec2 q=p-vec2(0.0,0.25);
    for(int j=0;j<6;j++) {
        float i=float(j);
        float r=2.1+i*0.31+0.12*sin(t*0.6+i);
        vec2 v=rot(t*(0.06+i*0.012)+i*0.16)*q;
        float d=abs(length(v/vec2(1.0,0.45+i*0.08))-r)*0.6;
        float opening=0.25+0.75*smoothstep(-0.2,0.7,sin(atan(v.y,v.x)*2.0+t));
        c+=glow(d,0.005,mix(CYAN,PINK,i/6.0),0.22*enter*opening,aa);
    }
    float sweep=sin(t*0.72)*2.0;
    c+=glow(lineDistance(p,vec2(-5.8,-1.4),vec2(-5.8+11.6*enter,-1.4)),0.008,CYAN,0.4,aa);
    c+=glow(length(p-vec2(sweep,-1.4)),0.03,WHITE,0.7,aa);
    return c*gate(t,0.0,12.6);
}
vec3 algebraStage(vec2 p,float t,float aa) {
    vec3 c=vec3(0.0);
    float k=t-28.0;
    for(int j=0;j<4;j++) {
        float i=float(j),side=i<2.0?-1.0:1.0;
        float y=mod(i,2.0)<0.5?-1.8:1.8;
        vec2 a=vec2(side*(6.2+0.08*sin(k)),y);
        c+=glow(lineDistance(p,a,a-vec2(side*0.55,0.0)),0.008,CYAN,0.5,aa);
        c+=glow(lineDistance(p,a,a-vec2(0.0,sign(y)*0.3)),0.008,CYAN,0.5,aa);
    }
    for(int j=0;j<5;j++) {
        float i=float(j),r=0.17+0.035*i;
        vec2 center=vec2(-4.0+i*2.0,-2.65);
        vec2 q=rot(k*0.35+i)* (p-center);
        float blend=0.5+0.5*sin(k*0.8+i*0.65);
        float radius=mix(length(q),max(abs(q.x),abs(q.y)),blend);
        c+=glow(abs(radius-r),0.008,mix(CYAN,GOLD,i/4.0),0.65,aa);
    }
    return c*gate(t,28.0,48.3);
}
vec3 closingStage(vec2 p,float t,float aa) {
    vec3 c=vec3(0.0);
    float a=smoothstep(113.7,115.5,t);
    vec2 q=rot(0.15+(t-114.0)*0.015)*(p-vec2(0.0,0.1));
    for(int j=0;j<3;j++) {
        float i=float(j);
        float d=abs(length(q/vec2(5.8+i*0.12,2.0+i*0.15))-1.0)*2.0;
        c+=glow(d,0.005,mix(CYAN,GOLD,i/2.0),0.3*a,aa);
    }
    c+=glow(lineDistance(p,vec2(-0.5,1.65),vec2(0.5,1.65)),0.018,GOLD,a,aa);
    return c;
}
void main() {
    vec2 v=uv;
    if(EXTRA_VECTOR2.x>0.5) v.y=1.0-v.y;
    float height=EXTRA_VECTOR2.z>0.0?EXTRA_VECTOR2.z:1.0;
    vec2 local=vec2(v.x,(v.y-EXTRA_VECTOR2.y)/height);
    vec4 original=texture2D(TEXTURE_0,uv);
    if(local.y<0.0 || local.y>1.0) { gl_FragColor=original; return; }
    float aspect=EXTRA_VECTOR1.y;
    float narrow=max(1.0,(16.0/9.0)/aspect);
    vec2 p=vec2((local.x-0.5)*aspect,0.5-local.y)*9.0*narrow;
    float aa=9.0/max(EXTRA_VECTOR1.z,1.0)*narrow;
    float t=clamp(EXTRA_VECTOR1.x,0.0,120.0);
    vec3 c=atmosphere(p,t,aa);
    if(t<12.6) c+=introStage(p,t,aa);
    c+=geometryAct(p,t,aa);
    if(t>=28.0 && t<48.3) c+=algebraStage(p,t,aa);
    if(t>113.7) c+=closingStage(p,t,aa);
    typography(c,p,t,aa);
    // Fine progress arc at the perimeter links the chapters without UI chrome.
    float edgeAngle=atan(p.y,p.x);
    float border=abs(length(p/vec2(7.8,4.15))-1.0)*4.0;
    c+=glow(border,0.003,CYAN,0.06*step(edgeAngle+PI,t/120.0*TAU),aa);
    c*=0.9+0.1*exp(-dot(p,p)*0.01);
    c=clamp(c,0.0,1.0)*smoothstep(0.0,0.6,t);
    gl_FragColor=mix(original,vec4(c,1.0),clamp(EXTRA_VECTOR1.w,0.0,1.0));
}

// __multiversion__
// Wind's Reply: twenty-four geometric pieces remember a single star.
// Each piece keeps four corresponding vertices through every chapter.
precision highp float;
#include "fragmentVersionCentroidUV.h"
uniform sampler2D TEXTURE_0;
uniform sampler2D TEXTURE_2;
uniform vec4 EXTRA_VECTOR1;
uniform vec4 EXTRA_VECTOR2;
const float PI=3.14159265359;
const float TAU=6.28318530718;
const vec3 PAPER=vec3(1.,.965,.865);
const vec3 GOLD=vec3(1.,.735,.365);
const vec3 CYAN=vec3(.255,.805,.72);
const vec3 CORAL=vec3(1.,.48,.365);
float sat(float x) { return clamp(x,0.,1.); }
float ease(float a,float b,float t) { return smoothstep(a,b,t); }
float hash(float n) { return fract(sin(n*127.1+311.7)*43758.5453); }
mat2 rotate(float a) { return mat2(cos(a),-sin(a),sin(a),cos(a)); }
float fill(float d,float aa) { return 1.-smoothstep(-aa,aa,d); }
vec2 polar(float angle,float radius) { return vec2(cos(angle),sin(angle))*radius; }
float segment(vec2 p,vec2 a,vec2 b) {
    vec2 edge=b-a;
    return length(p-a-edge*sat(dot(p-a,edge)/max(dot(edge,edge),.0000001)));
}
vec2 bezier(vec2 a,vec2 b,vec2 c,vec2 d,float u) {
    float v=1.-u; return v*v*v*a+3.*v*v*u*b+3.*v*u*u*c+u*u*u*d;
}
void glowLine(inout vec3 c,float d,float width,vec3 hue,float power,float aa) {
    c+=hue*power*(fill(d-width,aa)+.115*exp(-d*31.)+.018*exp(-d*9.));
}
float edgeCross(vec2 p,vec2 a,vec2 b) {
    if((a.y>p.y)==(b.y>p.y)) return 0.;
    return p.x<(b.x-a.x)*(p.y-a.y)/(b.y-a.y)+a.x?1.:0.;
}
float quadDistance(vec2 p,vec2 a,vec2 b,vec2 c,vec2 d) {
    float distance=min(min(segment(p,a,b),segment(p,b,c)),min(segment(p,c,d),segment(p,d,a)));
    float inside=mod(edgeCross(p,a,b)+edgeCross(p,b,c)+edgeCross(p,c,d)+edgeCross(p,d,a),2.);
    return distance*(1.-2.*inside);
}
vec3 storyPieceColor(float i) {
    float k=mod(i,12.);
    if(k<.5) return mix(PAPER,CORAL,.57);
    if(abs(k-4.)<.5 || abs(k-8.)<.5) return mix(PAPER,GOLD,.70);
    if(i>11.5 && (abs(k-2.)<.5 || abs(k-6.)<.5 || abs(k-10.)<.5)) return mix(PAPER,CYAN,.66);
    return PAPER;
}
vec2 nucleus(float t) {
    return vec2(mix(-1.2,0.,ease(16.,24.,t)),.45);
}
float wholeAngle(float t) { return .07*sin((t-20.)*.23); }
float wholeScale(float t) { return 1.+.025*sin((t-20.)*.5); }

// A recognisable six-pointed star is tiled by twelve closed wedges, with a
// smaller second layer. The star's outer diameter is 4.30 scene units.
vec2 originalCenter(float i) {
    float layer=floor(i/12.),k=mod(i,12.),scale=mix(1.,.57,layer);
    float a=k*TAU/12.+layer*PI/6.+PI/2.;
    float b=a+TAU/12.;
    float ra=mod(k,2.)<.5?2.15:1.04;
    float rb=mod(k+1.,2.)<.5?2.15:1.04;
    return (polar(a,.23+ra)+polar(b,.23+rb))*(scale*.25);
}
vec2 crownCenter(float i) {
    float layer=floor(i/12.),angle=(mod(i,12.)+.5)*TAU/12.+layer*PI/12.;
    float radius=mix(2.18,1.48,layer),shoulder=radius*.46;
    return polar(angle,(.24+layer*.06+radius+2.*cos(.205)*shoulder)*.25);
}
vec2 burstTarget(float i) {
    float angle=i*2.399963+.30,radius=3.0+hash(i+13.)*3.25;
    return vec2(cos(angle)*radius,sin(angle)*(1.55+hash(i+7.)*.50)) + vec2(0.,.45);
}
vec2 driftPosition(float i,float t) {
    float age=max(0.,t-50.);
    vec2 from=burstTarget(i);
    vec2 drift=from+vec2(sin(age*.16+i)*.45,cos(age*.19+i*.8)*.28)*ease(50.,57.,t);
    float angle=i*2.399963+.30+(t-64.)*(.12+hash(i+8.)*.035);
    float radius=2.45+mod(i,6.)*.53;
    vec2 orbit=vec2(cos(angle)*radius,sin(angle)*radius*.45)+vec2(0.,.45);
    return mix(drift,orbit,ease(64.,73.,t));
}
float gatherStart(float i) { return 78.+i/23.*9.; }
float gatherAmount(float i,float t) { return ease(gatherStart(i),gatherStart(i)+7.,t); }
float wingAmount(float i,float t) { return ease(94.+mod(i,12.)*.10,104.+mod(i,12.)*.10,t); }
vec2 lateCenter(float i,float t) {
    float framing=ease(104.,110.,t);
    if(i>11.5) return crownCenter(i)*mix(.93,.39,framing)+vec2(0.,mix(.45,2.02,framing));
    float side=i<6.?-1.:1.,order=mod(i,6.);
    vec2 root=vec2(side*mix(.43,1.28,framing),mix(.45,1.67,framing));
    vec2 tip=vec2(side*(6.65-order*.18),2.88-order*.64);
    return mix(root,tip,.48);
}
vec2 pieceCenter(float i,float t) {
    if(t<43.) return nucleus(t)+rotate(wholeAngle(t))*originalCenter(i)*ease(12.,20.,t)*wholeScale(t);
    if(t<50.) {
        vec2 from=nucleus(43.)+rotate(wholeAngle(43.))*originalCenter(i)*wholeScale(43.);
        vec2 to=burstTarget(i),impulse=to-from;
        float u=ease(43.+hash(i+12.)*.24,50.,t);
        return bezier(from,from+impulse*.56+vec2(.0,.52),to-impulse*.12,to,u);
    }
    float start=gatherStart(i);
    if(t<start) return driftPosition(i,t);
    vec2 destination=vec2(0.,.45)+crownCenter(i);
    if(t<94.) {
        vec2 from=driftPosition(i,start);
        float side=mod(i,2.)<.5?-1.:1.;
        vec2 control1=rotate(side*.59)*(from-vec2(0.,.45))*.92+vec2(0.,.45);
        vec2 control2=destination+rotate(side*.70)*(destination-vec2(0.,.45))*.87;
        return bezier(from,control1,control2,destination,gatherAmount(i,t));
    }
    return mix(destination,lateCenter(i,t),wingAmount(i,t));
}
void pieceCorners(float i,float t,out vec2 a,out vec2 b,out vec2 c,out vec2 d) {
    float layer=floor(i/12.),k=mod(i,12.),scale=mix(1.,.57,layer);
    float angle=k*TAU/12.+layer*PI/6.+PI/2.;
    vec2 axisA=polar(angle,scale),axisB=polar(angle+TAU/12.,scale);
    float ra=mod(k,2.)<.5?2.15:1.04,rb=mod(k+1.,2.)<.5?2.15:1.04;
    a=axisA*.23; b=axisA*ra; c=axisB*rb; d=axisB*.23;
    vec2 center=(a+b+c+d)*.25;
    float frozen=min(t,43.),size=wholeScale(frozen);
    mat2 turn=rotate(wholeAngle(frozen));
    a=turn*(a-center)*size; b=turn*(b-center)*size;
    c=turn*(c-center)*size; d=turn*(d-center)*size;
    if(t<43.) { float born=ease(12.,20.,t); a*=born; b*=born; c*=born; d*=born; return; }
    float start=gatherStart(i),gather=gatherAmount(i,t);
    float spin=(min(t,start)-43.)*(.23+hash(i+6.)*.19)*ease(43.,45.,t);
    mat2 tumble=rotate(spin); size=mix(1.,.64,ease(43.,48.,t));
    a=tumble*a*size; b=tumble*b*size; c=tumble*c*size; d=tumble*d*size;
    angle=(k+.5)*TAU/12.+layer*PI/12.;
    float radius=mix(2.18,1.48,layer);
    vec2 ca=polar(angle,.24+layer*.06),cb=polar(angle-.205,radius*.46);
    vec2 cc=polar(angle,radius),cd=polar(angle+.205,radius*.46);
    center=(ca+cb+cc+cd)*.25;
    ca-=center; cb-=center; cc-=center; cd-=center;
    a=mix(a,ca,gather); b=mix(b,cb,gather); c=mix(c,cc,gather); d=mix(d,cd,gather);
    if(t<94.) return;
    float framing=ease(104.,110.,t),wing=wingAmount(i,t);
    if(i>11.5) {
        size=mix(.93,.39,framing);
        a=mix(ca,ca*size,wing); b=mix(cb,cb*size,wing);
        c=mix(cc,cc*size,wing); d=mix(cd,cd*size,wing); return;
    }
    float side=i<6.?-1.:1.,order=mod(i,6.);
    vec2 root=vec2(side*mix(.43,1.28,framing),mix(.45,1.67,framing));
    vec2 tip=vec2(side*(6.65-order*.18),2.88-order*.64),shoulder=mix(root,tip,.46);
    vec2 normal=vec2(-(tip-root).y,(tip-root).x)/max(length(tip-root),.001);
    center=mix(root,tip,.48);
    a=mix(ca,root-center,wing); b=mix(cb,shoulder-normal*(.21-order*.015)-center,wing);
    c=mix(cc,tip-center,wing); d=mix(cd,shoulder+normal*(.21-order*.015)-center,wing);
}
void pieces(inout vec3 c,vec2 p,float t,float aa) {
    if(t<12.) return;
    for(int j=0;j<24;j++) {
        float i=float(j); vec2 at=pieceCenter(i,t),q=p-at;
        // Conservative radius rejection precedes all four-corner work. One
        // shared transform supplies the exact box and the four edge distances.
        float bound=t>=94. && i<11.5?4.2:1.9;
        if(max(abs(q.x),abs(q.y))>bound) continue;
        vec2 a,b,d,e; pieceCorners(i,t,a,b,e,d);
        vec2 lo=min(min(a,b),min(d,e))-.19,hi=max(max(a,b),max(d,e))+.19;
        if(q.x<lo.x || q.y<lo.y || q.x>hi.x || q.y>hi.y) continue;
        float signedDistance=quadDistance(q,a,b,e,d),distance=abs(signedDistance);
        float born=ease(12.,18.,t),loose=ease(43.,48.,t)*(1.-gatherAmount(i,t));
        float layer=floor(i/12.);
        vec3 hue=storyPieceColor(i);
        float panel=(.065+loose*.085+layer*.025)*born;
        c=mix(c,mix(hue,CYAN,.12),fill(signedDistance,aa)*panel);
        glowLine(c,distance,.015+loose*.004,hue,(1.48+loose*.17)*born,aa);
    }
}

// Three broad ribbons provide a supporting shape, then a current, an orbit,
// and the final frame. Their pale spines retain a clear mathematical edge.
vec2 openingWind(float i,float u) {
    float offset=i*.115;
    return bezier(vec2(-7.7,.86-offset),vec2(-3.6,.63-offset),
                  vec2(-.3,-2.30-offset),vec2(7.7,-1.35-offset),u);
}
vec2 cradleWind(float i,float u,float t) {
    float offset=(i-1.)*.18;
    return bezier(vec2(-8.,1.30+offset),vec2(-4.7,-3.28+offset),
                  vec2(2.4,-2.93+offset),vec2(8.,1.65+offset),u)
                  +vec2(0.,.055*sin(t*.31+i+u*5.));
}
vec2 flowingWind(float i,float u,float t) {
    float y=(i-1.)*1.08+.35;
    return vec2(-8.1+u*16.2,y+sin(u*TAU*.83+i*.51-t*.14)*(.65+i*.05));
}
vec2 orbitWind(float i,float u,float t) {
    float angle=u*TAU*.84+i*TAU/3.+t*.022;
    float radius=2.72+i*.52;
    return rotate(-.16+i*.09)*vec2(cos(angle)*radius,sin(angle)*radius*.61)+vec2(0.,.45);
}
vec2 closingWind(float i,float u) {
    float offset=i*.17;
    return bezier(vec2(-8.,-.23-offset),vec2(-4.65,-3.28-offset),
                  vec2(4.65,-3.28-offset),vec2(8.,-.23-offset),u);
}
vec2 windPoint(float i,float u,float t) {
    if(t<12.) return openingWind(i,u);
    if(t<20.) return mix(openingWind(i,u),cradleWind(i,u,t),ease(12.,20.,t));
    if(t<42.) return cradleWind(i,u,t);
    if(t<51.) return mix(cradleWind(i,u,t),flowingWind(i,u,t),ease(42.,51.,t));
    if(t<64.) return flowingWind(i,u,t);
    if(t<73.) return mix(flowingWind(i,u,t),orbitWind(i,u,t),ease(64.,73.,t));
    if(t<78.) return orbitWind(i,u,t);
    if(t<94.) return mix(orbitWind(i,u,t),cradleWind(i,u,t),ease(78.,94.,t));
    if(t<96.) return cradleWind(i,u,t);
    if(t<110.) return mix(cradleWind(i,u,t),closingWind(i,u),ease(96.,110.,t));
    return closingWind(i,u);
}
void winds(inout vec3 c,vec2 p,float t,float aa) {
    if(abs(p.y)>3.35) return;
    for(int j=0;j<3;j++) {
        float i=float(j),start=1.+i*.90,draw=ease(start,start+5.1,t);
        if(draw<.001) continue;
        float distance=20.,nearest=0.; vec2 previous=windPoint(i,0.,t);
        for(int k=1;k<=36;k++) {
            float u=float(k)/36.*draw; vec2 current=windPoint(i,u,t);
            vec2 lo=min(previous,current)-.30,hi=max(previous,current)+.30;
            if(p.x>=lo.x && p.x<=hi.x && p.y>=lo.y && p.y<=hi.y) {
                float candidate=segment(p,previous,current);
                if(candidate<distance) { distance=candidate; nearest=u; }
            }
            previous=current;
        }
        if(distance>.29) continue;
        float taper=pow(max(0.,sin(PI*nearest)),.62);
        float width=.008+(.054+i*.012)*taper;
        vec3 hue=j==1?GOLD:CYAN;
        float strength=(j==2?.68:1.)*(.78+.12*sin(t*.25+i));
        c+=hue*fill(distance-width,aa)*(.32*taper*strength);
        glowLine(c,distance,.007+.003*taper,mix(hue,PAPER,.49),.55*taper*strength,aa);
    }
}

vec2 meteorPosition(float time) {
    if(time<=43.) {
        float u=sat((time-32.)/11.);
        return bezier(vec2(-9.4,5.3),vec2(-6.6,4.0),vec2(-2.0,1.10),vec2(0.,.45),u);
    }
    return bezier(vec2(0.,.45),vec2(2.3,-.16),vec2(7.,-2.0),vec2(11.,-4.7),sat((time-43.)/5.));
}
void meteor(inout vec3 c,vec2 p,float t,float aa) {
    if(t<32. || t>49.) return;
    vec2 head=meteorPosition(t);
    float visible=1.-ease(46.5,49.,t);
    for(int strand=0;strand<3;strand++) {
        float i=float(strand),distance=20.,nearest=0.; vec2 previous=head;
        for(int k=1;k<=20;k++) {
            float u=float(k)/20.,past=t-u*(3.8+i*.20);
            vec2 current=meteorPosition(past);
            vec2 tangent=meteorPosition(past+.035)-current;
            vec2 normal=vec2(-tangent.y,tangent.x)/max(length(tangent),.0001);
            current+=normal*(i-1.)*.095*sin(u*PI);
            vec2 lo=min(previous,current)-.24,hi=max(previous,current)+.24;
            if(p.x>=lo.x && p.x<=hi.x && p.y>=lo.y && p.y<=hi.y) {
                float candidate=segment(p,previous,current);
                if(candidate<distance) { distance=candidate; nearest=u; }
            }
            previous=current;
        }
        if(distance>.23) continue;
        float taper=pow(1.-nearest,1.18),width=.005+(.035-i*.007)*taper;
        vec3 hue=strand==0?PAPER:(strand==1?GOLD:CYAN);
        glowLine(c,distance,width,hue,(.52+1.18*taper)*visible,aa);
    }
    float radius=length(p-head);
    if(radius<.6) c+=PAPER*visible*(2.2*fill(radius-.075,aa)+.40*exp(-radius*15.));
    float age=t-43.;
    if(age>=0. && age<3.4) {
        vec2 q=p-vec2(0.,.45); float r=length(q),energy=1.-ease(.1,3.4,age);
        float ring=abs(r-(.20+age*3.25));
        if(ring<.28) glowLine(c,ring,.024+age*.006,mix(PAPER,GOLD,.36),energy*.68,aa);
        c+=PAPER*exp(-age*age*9.)*.78*exp(-r*r*.82);
    }
}
void coreLight(inout vec3 c,vec2 p,float t,float aa) {
    float birth=ease(12.,20.,t),whole=1.-ease(43.,45.,t),back=ease(84.,94.,t);
    float presence=max(birth*whole,back),framing=ease(104.,110.,t);
    vec2 at=mix(nucleus(t),vec2(0.,2.02),framing);
    vec2 q=p-at; float radius=length(q);
    if(radius>3.) return;
    c+=mix(GOLD,CYAN,back*.48)*presence*(.15*exp(-radius*radius*1.35)+.025*exp(-radius*radius*.20));
    float hex=max(abs(q.x)*.866025+abs(q.y)*.5,abs(q.y));
    float size=mix(.125,.095,framing);
    c+=PAPER*presence*(1.35*fill(hex-size,aa)+.16*exp(-radius*13.));
    float reunion=exp(-pow((t-94.)/.65,2.));
    c+=PAPER*reunion*.22*exp(-radius*radius*.35);
}
void reunionTrails(inout vec3 c,vec2 p,float t,float aa) {
    if(t<78. || t>94.) return;
    // Eight return paths are sufficient to show the direction of the wind.
    for(int j=0;j<8;j++) {
        float i=float(j)*3.,start=gatherStart(i);
        if(t<start || t>start+7.) continue;
        float distance=20.,nearest=0.; vec2 previous=pieceCenter(i,t);
        for(int k=1;k<=12;k++) {
            float u=float(k)/12.; vec2 current=pieceCenter(i,max(start,t-u*2.3));
            vec2 lo=min(previous,current)-.15,hi=max(previous,current)+.15;
            if(p.x>=lo.x && p.x<=hi.x && p.y>=lo.y && p.y<=hi.y) {
                float candidate=segment(p,previous,current);
                if(candidate<distance) { distance=candidate; nearest=u; }
            }
            previous=current;
        }
        if(distance>.14) continue;
        float strength=(1.-nearest)*ease(start,start+.7,t)*(1.-ease(start+5.9,start+7.,t));
        glowLine(c,distance,.012,storyPieceColor(i),strength*.52,aa);
    }
}
void stardust(inout vec3 c,vec2 p,float t,float aa) {
    for(int j=0;j<32;j++) {
        float i=float(j),h=hash(i+2.3);
        vec2 at=vec2(hash(i+23.)*15.2-7.6,hash(i+46.)*5.9-2.55);
        at+=vec2(.09*sin(t*.08+i),.07*cos(t*.10+i));
        vec2 q=p-at;
        if(max(abs(q.x),abs(q.y))>.12) continue;
        float r=length(q),pulse=.64+.36*sin(t*.42+i*1.7);
        c+=mix(PAPER,GOLD,h*.5)*pulse*(fill(r-(.007+h*.009),aa)*.33+.025*exp(-r*32.));
    }
}
vec3 space(vec2 p,float t) {
    vec3 c=vec3(.014,.030,.045);
    c+=vec3(.010,.024,.029)*exp(-dot(p-vec2(-2.,.5),p-vec2(-2.,.5))*.045);
    c+=vec3(.017,.017,.012)*exp(-dot(p-vec2(3.,.7),p-vec2(3.,.7))*.08);
    float reunion=ease(78.,96.,t);
    c+=vec3(.013,.023,.021)*reunion*exp(-dot(p,p)*.13);
    return c;
}

float sdfSample(vec2 q,vec4 tile) {
    q.y=1.-q.y;
    vec2 pix=clamp(tile.xy+q*tile.zw-.5,tile.xy,tile.xy+tile.zw-1.);
    vec2 b=floor(pix),f=fract(pix);
    float a=texture2D(TEXTURE_2,(b+vec2(.5,.5))/4096.).r;
    float b0=texture2D(TEXTURE_2,(b+vec2(1.5,.5))/4096.).r;
    float c0=texture2D(TEXTURE_2,(b+vec2(.5,1.5))/4096.).r;
    float d=texture2D(TEXTURE_2,(b+vec2(1.5,1.5))/4096.).r;
    return (mix(mix(a,b0,f.x),mix(c0,d,f.x),f.y)-.5)*48.;
}
void letter(inout vec3 c,vec2 p,vec2 at,vec2 size,vec4 tile,vec3 hue,float opacity,float aa) {
    vec2 q=(p-at)/size+.5; if(min(q.x,q.y)<.003 || max(q.x,q.y)>.997) return;
    float d=sdfSample(q,tile),edge=clamp(.5*fwidth(d),.55,8.);
    c=mix(c,hue,smoothstep(-edge,edge,d)*opacity);
}
// __STORY_VECTOR_MORPH__
// __STORY_TYPOGRAPHY__

void main() {
    vec2 v=uv; if(EXTRA_VECTOR2.x>.5) v.y=1.-v.y;
    float height=EXTRA_VECTOR2.z>0.?EXTRA_VECTOR2.z:1.;
    vec2 local=vec2(v.x,(v.y-EXTRA_VECTOR2.y)/height); vec4 original=texture2D(TEXTURE_0,uv);
    if(local.y<0. || local.y>1.) { gl_FragColor=original; return; }
    float aspect=max(EXTRA_VECTOR1.y,.1),narrow=max(1.,(16./9.)/aspect);
    vec2 p=vec2((local.x-.5)*aspect,.5-local.y)*9.*narrow;
    float aa=9./max(EXTRA_VECTOR1.z,1.)*narrow,t=clamp(EXTRA_VECTOR1.x,0.,120.);
    vec3 c=space(p,t);
    stardust(c,p,t,aa); winds(c,p,t,aa); reunionTrails(c,p,t,aa);
    pieces(c,p,t,aa); coreLight(c,p,t,aa); meteor(c,p,t,aa);
    c=vec3(1.)-exp(-c*1.16);
    c*=1.-.09*sat(dot(p*vec2(.075,.11),p*vec2(.075,.11)));
    typography(c,p,t,aa);
    c*=1.-ease(3.71,3.75,abs(p.y));
    gl_FragColor=mix(original,vec4(clamp(c,0.,1.),1.),clamp(EXTRA_VECTOR1.w,0.,1.));
}

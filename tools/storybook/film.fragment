// __multiversion__
// A mathematical fairy tale: wind, a waking star, a meteor, and a soul rejoined.
// All 48 fragments retain their identity and their corresponding curve points.
precision highp float;
#include "fragmentVersionCentroidUV.h"
uniform sampler2D TEXTURE_0;
uniform sampler2D TEXTURE_2;
uniform vec4 EXTRA_VECTOR1;
uniform vec4 EXTRA_VECTOR2;
const float PI=3.14159265359;
const float TAU=6.28318530718;
const vec3 GOLD=vec3(.98,.74,.38);
const vec3 CYAN=vec3(.34,.78,.89);
const vec3 VIOLET=vec3(.66,.49,.94);
const vec3 PAPER=vec3(.94,.91,.83);
float sat(float x) { return clamp(x,0.,1.); }
float ease(float a,float b,float t) { return smoothstep(a,b,t); }
float hash(float n) { return fract(sin(n*127.1+311.7)*43758.5453); }
mat2 rotate(float a) { return mat2(cos(a),-sin(a),sin(a),cos(a)); }
float fill(float d,float aa) { return 1.-smoothstep(-aa,aa,d); }
float segment(vec2 p,vec2 a,vec2 b) {
    vec2 edge=b-a;
    return length(p-a-edge*sat(dot(p-a,edge)/max(dot(edge,edge),.0000001)));
}
vec2 bezier(vec2 a,vec2 b,vec2 c,vec2 d,float u) {
    float v=1.-u; return v*v*v*a+3.*v*v*u*b+3.*v*u*u*c+u*u*u*d;
}
vec3 storyFragmentColor(float i) {
    vec3 hue=mix(GOLD,CYAN,hash(i+34.));
    return mix(hue,VIOLET,ease(.68,.94,hash(i+91.))*.82);
}
void glowLine(inout vec3 c,float d,float width,vec3 hue,float power,float aa) {
    c+=hue*power*(fill(d-width,aa)+.17*exp(-d*42.)+.029*exp(-d*11.));
}
vec2 nucleus(float t) { return vec2(mix(-.4,0.,ease(18.,26.,t)),.2); }

// The original star is two uninterrupted, rotating rose curves. The 24 pieces
// in each curve are adjacent parameter intervals, not newly spawned particles.
vec2 originalPoint(float i,float u,float t) {
    float layer=floor(i/24.),theta=(mod(i,24.)+u)*TAU/24.;
    float birth=ease(14.,24.,t),turn=.065*(t-16.)*(1.-layer*1.55);
    float r=(.47+layer*.33)*(1.+.22*cos(5.*theta+layer*.65))*birth;
    return rotate(turn)*vec2(cos(theta)*r,sin(theta)*r);
}
vec2 soulPoint(float i,float u) {
    float layer=floor(i/24.),theta=(mod(i,24.)+u)*TAU/24.;
    float r=(1.03+layer*.36)*(1.+.255*cos(6.*theta+layer*.54));
    return rotate(.13+layer*.11)*vec2(cos(theta)*r,sin(theta)*r*.89);
}
vec2 burstTarget(float i) {
    float angle=i*2.399963+.31,rad=2.2+hash(i+13.)*3.75;
    return vec2(cos(angle)*rad,sin(angle)*rad*.47)+vec2(0.,.35);
}
vec2 driftPosition(float i,float t) {
    vec2 initial=burstTarget(i);
    float angle=i*2.399963+.31+(t-54.)*(.095+hash(i+8.)*.030);
    float rad=2.2+hash(i+13.)*3.75;
    vec2 orbit=vec2(cos(angle)*rad,sin(angle)*rad*.47)+vec2(.18*sin(t*.10),.35);
    orbit+=vec2(.15*sin(t*.31+i),.10*cos(t*.27+i));
    return mix(initial,orbit,ease(54.,61.,t));
}
vec2 finalStar(float i) {
    float side=mod(i,2.)<.5?-1.:1.;
    return vec2(side*(2.55+hash(i+17.)*4.7),-1.95+hash(i+4.)*4.95);
}
float gatherAmount(float i,float t) {
    float start=76.+i/47.*9.5;
    return ease(start,start+8.4,t);
}
float spreadAmount(float i,float t) { return ease(96.+i/48.*2.,103.8+i/48.*2.,t); }
vec2 fragmentCenter(float i,float t) {
    if(t<43.) return nucleus(t)+originalPoint(i,.5,t);
    vec2 initial=vec2(0.,.2)+originalPoint(i,.5,43.);
    if(t<54.) {
        float u=ease(43.+hash(i+12.)*.42,51.,t); vec2 target=burstTarget(i);
        vec2 impulse=target-initial;
        return bezier(initial,initial+impulse*.58+vec2(.2,.3),target-impulse*.15,target,u);
    }
    float start=76.+i/47.*9.5;
    if(t<start) return driftPosition(i,t);
    vec2 destination=vec2(0.,.2)+soulPoint(i,.5);
    if(t<96.) {
        float u=gatherAmount(i,t); vec2 from=driftPosition(i,start);
        float side=mod(i,2.)<.5?-1.:1.;
        vec2 control1=rotate(side*.64)*(from-vec2(0.,.2))*.92+vec2(0.,.2);
        vec2 control2=destination+rotate(side*.65)*(destination-vec2(0.,.2))*.90;
        return bezier(from,control1,control2,destination,u);
    }
    vec2 target=finalStar(i); float u=spreadAmount(i,t);
    return bezier(destination,destination*1.5+vec2(.0,.35),target*.86+vec2(.0,.45),target,u);
}
vec2 fragmentLocal(float i,float u,float t) {
    if(t<43.) return originalPoint(i,u,t)-originalPoint(i,.5,t);
    vec2 original=originalPoint(i,u,43.)-originalPoint(i,.5,43.);
    float gather=gatherAmount(i,t),spin=(t-43.)*(.11+hash(i+6.)*.18);
    float stop=76.+i/47.*9.5;
    spin=mix(spin,(stop-43.)*(.11+hash(i+6.)*.18),gather);
    vec2 broken=rotate(spin)*original*(1.+.16*sin((t-43.)*.5+i)*(1.-gather));
    vec2 complete=soulPoint(i,u)-soulPoint(i,.5);
    vec2 point=mix(broken,complete,gather);
    if(t>=96.) {
        float theta=u*TAU,r=(.07+hash(i+21.)*.055)*(.24+.76*pow(abs(cos(theta*2.)),5.));
        vec2 star=vec2(cos(theta),sin(theta))*r;
        point=mix(complete,star,spreadAmount(i,t));
    }
    return point;
}
void fragments(inout vec3 c,vec2 p,float t,float aa) {
    if(t<14.) return;
    for(int j=0;j<48;j++) {
        float i=float(j); vec2 at=fragmentCenter(i,t),q=p-at;
        // Every local segment is enclosed by this conservative box. No atlas
        // fetch or curve subdivision occurs outside its small screen region.
        if(max(abs(q.x),abs(q.y))>.96) continue;
        float d=20.; vec2 previous=fragmentLocal(i,0.,t);
        for(int k=1;k<=16;k++) {
            vec2 current=fragmentLocal(i,float(k)/16.,t);
            d=min(d,segment(q,previous,current)); previous=current;
        }
        float birth=ease(14.,20.,t),rejoined=gatherAmount(i,t);
        float width=.009+rejoined*.004;
        vec3 hue=storyFragmentColor(i);
        glowLine(c,d,width,hue,(.48+.18*rejoined)*birth,aa);
        float sparkle=.8+.2*sin(t*.83+i*1.4);
        c+=hue*.022*birth*sparkle*exp(-dot(q,q)*13.);
    }
}

// Six visible wind strokes preserve their parameter identities. First they
// carry the two opening lines; then they become orbits, a vortex and a frame.
vec2 openingWind(float i,float u) {
    float group=step(2.5,i),strand=mod(i,3.),x=mix(-2.,2.,group),y=mix(1.13,-1.67,group)-strand*.062;
    return bezier(vec2(x-4.45,y+.13),vec2(x-1.9,y-.16-strand*.035),
                  vec2(x+1.45,y-.04),vec2(x+4.4,y+.17),u);
}
vec2 orbitWind(float i,float u,float t) {
    float angle=u*TAU*.94+i*.66+t*.025;
    float radius=1.34+i*.145;
    return nucleus(t)+rotate(-.38+i*.23)*vec2(cos(angle)*radius,sin(angle)*radius*.43);
}
vec2 flowingWind(float i,float u,float t) {
    float y=(i-2.5)*.38+.30;
    return vec2(-8.2+u*16.4,y+sin(u*TAU*.88+i*.4-t*.18)*(.36+i*.025));
}
vec2 vortexWind(float i,float u,float t) {
    float angle=u*TAU*1.12+i*TAU/6.-t*.105;
    float radius=.48+u*5.95;
    return vec2(cos(angle)*radius,sin(angle)*radius*.48)+vec2(.12*sin(t*.10),.35);
}
vec2 restoredWind(float i,float u) {
    float theta=u*TAU+i*TAU/6.,r=.30+u*1.85;
    return vec2(cos(theta)*r,sin(theta)*r*.85)+vec2(0.,.2);
}
vec2 closingWind(float i,float u) {
    float strand=mod(i,3.),side=i<3.?1.:-1.;
    return bezier(vec2(-7.,side*(1.62+strand*.06)),vec2(-3.7,side*(3.28+strand*.06)),
                  vec2(3.8,side*(3.12+strand*.10)),vec2(7.,side*(1.64+strand*.10)),u);
}
vec2 windPoint(float i,float u,float t) {
    vec2 point=openingWind(i,u);
    point=mix(point,orbitWind(i,u,t),ease(i<3.?12.:18.,i<3.?18.:25.,t));
    point=mix(point,flowingWind(i,u,t),ease(41.,53.,t));
    point=mix(point,vortexWind(i,u,t),ease(53.,64.,t));
    point=mix(point,restoredWind(i,u),ease(76.,95.,t));
    return mix(point,closingWind(i,u),ease(96.,110.,t));
}
void winds(inout vec3 c,vec2 p,float t,float aa) {
    for(int j=0;j<6;j++) {
        float i=float(j),start=i<3.?1.:5.8,draw=ease(start,start+3.6,t);
        if(draw<.001) continue;
        float d=20.,nearest=0.; vec2 previous=windPoint(i,0.,t);
        for(int k=1;k<=48;k++) {
            float u=float(k)/48.*draw; vec2 current=windPoint(i,u,t);
            float distance=segment(p,previous,current);
            if(distance<d) { d=distance; nearest=u; } previous=current;
        }
        float taper=pow(max(.0,sin(PI*nearest)),.4);
        float storm=ease(43.,55.,t)*(1.-ease(76.,94.,t));
        float strength=mix(.24,.14,storm)*(1.-ease(107.,114.,t)*.20);
        vec3 hue=mod(i,3.)<.5?GOLD:mix(CYAN,VIOLET,mod(i,3.)*.22);
        glowLine(c,d,.004+.005*taper,hue,strength*(.15+.85*taper),aa);
    }
}

vec2 meteorPosition(float time) {
    if(time<=43.) {
        float u=sat((time-34.)/9.);
        return bezier(vec2(-9.1,4.7),vec2(-5.4,3.3),vec2(-2.2,.29),vec2(0.,.2),u);
    }
    return bezier(vec2(0.,.2),vec2(2.3,.11),vec2(7.0,-2.6),vec2(11.,-4.7),sat((time-43.)/7.));
}
void meteor(inout vec3 c,vec2 p,float t,float aa) {
    if(t<34. || t>52.) return;
    vec2 head=meteorPosition(t);
    float visible=1.-ease(50.,52.,t);
    for(int strand=0;strand<3;strand++) {
        float i=float(strand),d=20.,nearest=0.; vec2 previous=head;
        for(int k=1;k<=28;k++) {
            float u=float(k)/28.,past=t-u*(2.15+i*.22);
            vec2 current=meteorPosition(past);
            vec2 tangent=meteorPosition(past+.035)-current;
            vec2 normal=vec2(-tangent.y,tangent.x)/max(length(tangent),.0001);
            current+=normal*(i-1.)*.045*sin(u*PI)+normal*sin(u*7.+t*1.3+i)*.017*u;
            float distance=segment(p,previous,current);
            if(distance<d) { d=distance; nearest=u; } previous=current;
        }
        float taper=pow(1.-nearest,1.5),width=(.013+i*.003)*taper+.002;
        vec3 hue=i<.5?GOLD:(i<1.5?CYAN:VIOLET);
        glowLine(c,d,width,hue,(.34+.65*taper)*visible,aa);
    }
    float radius=length(p-head);
    c+=PAPER*visible*(1.1*fill(radius-.042,aa)+.31*exp(-radius*17.)+.045*exp(-radius*3.));
    // A single impact has an outward-moving wave and a short crossed flare.
    float age=t-43.;
    if(age>=0. && age<4.) {
        vec2 q=p-vec2(0.,.2); float energy=1.-ease(.1,3.7,age),r=length(q);
        float ring=abs(r-(.18+age*2.7));
        glowLine(c,ring,.010+age*.003,mix(GOLD,CYAN,sat(age)),energy*.28,aa);
        float flash=exp(-age*age*8.);
        c+=GOLD*flash*(.42*exp(-r*r*2.8)+.17*exp(-abs(q.y)*40.-abs(q.x)*.65));
        c+=PAPER*flash*.11*exp(-abs(q.x)*50.-abs(q.y)*1.8);
    }
}

void coreLight(inout vec3 c,vec2 p,float t,float aa) {
    float born=ease(12.,16.,t),broken=1.-ease(43.,45.8,t),restored=ease(82.,94.,t);
    float presence=max(born*broken,restored)*(1.-ease(99.,109.,t)*.78);
    vec2 q=p-nucleus(t); float r=length(q),breath=.88+.12*sin(t*.91);
    c+=GOLD*presence*breath*(.20*exp(-r*r*11.)+.022*exp(-r*r*.43));
    float core=.028+ease(16.,28.,t)*.018+restored*.012;
    c+=PAPER*presence*(.84*fill(r-core,aa)+.19*exp(-r*22.));
    // Diffraction rays are curved by the same slow orbital motion.
    float rays=exp(-abs(q.x)*83.-abs(q.y)*5.)+exp(-abs(q.y)*77.-abs(q.x)*4.);
    c+=GOLD*presence*rays*.10;
    float reunion=exp(-pow((t-94.)/.72,2.));
    c+=CYAN*reunion*.08*exp(-pow(r-1.85-(t-94.)*.55,2.)*40.);
}
void reunionTrails(inout vec3 c,vec2 p,float t,float aa) {
    if(t<76. || t>95.) return;
    // Only twelve of the tracked pieces carry long filaments. This keeps the
    // return paths legible without rendering 48 screen-wide Bézier trails.
    for(int j=0;j<12;j++) {
        float i=float(j)*4.,start=76.+i/47.*9.5;
        if(t<start || t>start+8.6) continue;
        float d=20.,nearest=0.; vec2 previous=fragmentCenter(i,t);
        for(int k=1;k<=16;k++) {
            float u=float(k)/16.,past=max(start,t-u*2.5);
            vec2 current=fragmentCenter(i,past);
            float distance=segment(p,previous,current);
            if(distance<d) { d=distance; nearest=u; } previous=current;
        }
        float strength=(1.-nearest)*ease(start,start+.8,t)*(1.-ease(start+7.5,start+8.6,t));
        glowLine(c,d,.006,storyFragmentColor(i),strength*.26,aa);
    }
}
void stardust(inout vec3 c,vec2 p,float t,float aa) {
    for(int j=0;j<72;j++) {
        float i=float(j),identity=mod(i,48.),h=hash(i+2.3);
        vec2 field=vec2(hash(i+23.)*16.2-8.1,hash(i+46.)*6.5-3.1);
        field+=vec2(.025*sin(t*.12+i),.018*cos(t*.15+i));
        vec2 offset=vec2(cos(i*2.399+t*.16),sin(i*2.399+t*.16))*(.12+h*.30);
        vec2 following=fragmentCenter(identity,max(t,14.))+offset;
        float follow=ease(18.,30.,t)*(1.-ease(105.,114.,t)*.65);
        vec2 at=mix(field,following,follow),q=p-at;
        if(max(abs(q.x),abs(q.y))>.35) continue;
        float r=length(q),active=ease(16.,30.,t),pulse=.80+.20*sin(t*.72+i*1.7);
        float size=.005+h*.009+active*.003;
        c+=storyFragmentColor(i)*pulse*(fill(r-size,aa)*(.22+active*.36)+(.014+active*.018)*exp(-r*24.));
    }
}
vec3 space(vec2 p,float t) {
    vec3 c=vec3(.008,.012,.025);
    c+=vec3(.009,.018,.031)*exp(-dot(p-vec2(-2.,.5),p-vec2(-2.,.5))*.055);
    c+=vec3(.013,.008,.025)*exp(-dot(p-vec2(3.,.4),p-vec2(3.,.4))*.09);
    float open=ease(18.,32.,t),returning=ease(83.,96.,t);
    c+=mix(vec3(.014,.010,.004),vec3(.005,.014,.022),returning)*open*exp(-dot(p,p)*.19);
    return c;
}

float sdfSample(vec2 q,vec4 tile) {
    q.y=1.-q.y;
    vec2 pix=clamp(tile.xy+q*tile.zw-.5,tile.xy,tile.xy+tile.zw-1.);
    vec2 b=floor(pix),f=fract(pix);
    float a=texture2D(TEXTURE_2,(b+vec2(.5,.5))/4096.).r;
    float b0=texture2D(TEXTURE_2,(b+vec2(1.5,.5))/4096.).r;
    float c0=texture2D(TEXTURE_2,(b+vec2(.5,1.5))/4096.).r;
    float d=texture2D(TEXTURE_2,(b+vec2(1.5,1.5))/4096.).r;
    return (mix(mix(a,b0,f.x),mix(c0,d,f.x),f.y)-.5)*48.;
}
void letter(inout vec3 c,vec2 p,vec2 at,vec2 size,vec4 tile,vec3 hue,float opacity,float aa) {
    vec2 q=(p-at)/size+.5; if(min(q.x,q.y)<.003 || max(q.x,q.y)>.997) return;
    float d=sdfSample(q,tile),edge=clamp(.5*fwidth(d),.55,8.);
    c=mix(c,hue,smoothstep(-edge,edge,d)*opacity);
}
// __STORY_VECTOR_MORPH__
// __STORY_TYPOGRAPHY__

void main() {
    vec2 v=uv; if(EXTRA_VECTOR2.x>.5) v.y=1.-v.y;
    float height=EXTRA_VECTOR2.z>0.?EXTRA_VECTOR2.z:1.;
    vec2 local=vec2(v.x,(v.y-EXTRA_VECTOR2.y)/height); vec4 original=texture2D(TEXTURE_0,uv);
    if(local.y<0. || local.y>1.) { gl_FragColor=original; return; }
    float aspect=max(EXTRA_VECTOR1.y,.1),narrow=max(1.,(16./9.)/aspect);
    vec2 p=vec2((local.x-.5)*aspect,.5-local.y)*9.*narrow;
    float aa=9./max(EXTRA_VECTOR1.z,1.)*narrow,t=clamp(EXTRA_VECTOR1.x,0.,120.);
    vec3 c=space(p,t);
    stardust(c,p,t,aa); winds(c,p,t,aa); reunionTrails(c,p,t,aa);
    fragments(c,p,t,aa); coreLight(c,p,t,aa); meteor(c,p,t,aa);
    // Additive radiance is compressed only for the illustration. Text retains
    // its calibrated Song colors and original SDF edge coverage afterwards.
    c=vec3(1.)-exp(-c*1.14);
    c*=1.-.16*sat(dot(p*vec2(.075,.11),p*vec2(.075,.11)));
    typography(c,p,t,aa);
    c*=1.-ease(3.71,3.75,abs(p.y));
    gl_FragColor=mix(original,vec4(clamp(c,0.,1.),1.),clamp(EXTRA_VECTOR1.w,0.,1.));
}

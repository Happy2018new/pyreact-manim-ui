// __multiversion__
precision highp float;
#include "fragmentVersionCentroidUV.h"
uniform sampler2D TEXTURE_0;
uniform sampler2D TEXTURE_3;
uniform highp vec4 EXTRA_VECTOR1; // viewportW,H,restoreEnabled,logicalBytes
uniform highp vec4 EXTRA_VECTOR2; // sourceROI x,y,width,height
uniform highp vec4 EXTRA_VECTOR3; // output x,y,width; W>1.5 is one-pixel alpha negative

vec4 encodedAtPixel(vec2 pixel) {
    vec2 location=(pixel+vec2(0.5))/EXTRA_VECTOR1.xy;
    location.y=1.0-location.y;
    return texture2D(TEXTURE_3,location);
}

void main() {
    vec4 current=texture2D(TEXTURE_0,uv);
    if (EXTRA_VECTOR1.z<0.5) {
        gl_FragColor=current;
        return;
    }
    vec2 pixel=floor(vec2(gl_FragCoord.x,EXTRA_VECTOR1.y-gl_FragCoord.y));
    vec2 relative=pixel-EXTRA_VECTOR2.xy;
    if (relative.x<0.0 || relative.y<0.0 || relative.x>=EXTRA_VECTOR2.z || relative.y>=EXTRA_VECTOR2.w) {
        gl_FragColor=current;
        return;
    }
    vec4 raw=encodedAtPixel(pixel);
    vec3 bytes=floor(raw.rgb*255.0+vec3(0.5));
    float restoredAlpha=raw.a;
    // Explicit diagnostic control: invert only the first source pixel's alpha.
    // Normal output.w values0/1 leave the restoration path unchanged.
    if (EXTRA_VECTOR3.w>1.5 && relative.x<0.5 && relative.y<0.5) {
        restoredAlpha=1.0-raw.a;
    }
    gl_FragColor=vec4(clamp(vec3(mod(bytes.r,64.0),bytes.g,bytes.b)/63.0,0.0,1.0),restoredAlpha);
}

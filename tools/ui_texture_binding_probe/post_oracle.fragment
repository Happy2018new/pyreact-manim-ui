// __multiversion__
precision highp float;
#include "fragmentVersionCentroidUV.h"
uniform sampler2D TEXTURE_0;
uniform sampler2D TEXTURE_1;
uniform vec4 EXTRA_VECTOR1; // source:0=previous,1=original; output:0=RGB,1=alpha

void main() {
    vec4 original=texture2D(TEXTURE_0,uv);
    if (uv.x<0.1 || uv.x>=0.9 || uv.y<0.05 || uv.y>=0.2) {
        gl_FragColor=original;
        return;
    }
    float index=min(floor((uv.x-0.1)*40.0),31.0);
    vec2 source=vec2(0.1+0.8*(index+0.5)/32.0,0.75);
    vec4 value=texture2D(TEXTURE_0,source);
    if (EXTRA_VECTOR1.x>0.5) value=texture2D(TEXTURE_1,source);
    gl_FragColor=vec4(EXTRA_VECTOR1.y>0.5 ? vec3(value.a) : value.rgb,1.0);
}
